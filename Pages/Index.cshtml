@page
@model CourseScheduleSystem.Web.Pages.IndexModel
@{
    ViewData["Title"] = "CSAS | UNILAK";
    ViewData["FullWidth"] = "true";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CSAS | UNILAK Academic Portal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <style>

        
        *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
        html  { scroll-behavior: smooth; }
        body  {
            font-family: 'Inter', sans-serif;
            color: #0D1E47;
            overflow-x: hidden;
            background: #0D1E47; 
        }
        a     { text-decoration: none; }

        :root {
            --navy:   #0D1E47;
            --blue:   #1C3B83;
            --mid:    #2952C8;
            --green:  #10b981;
            --muted:  #6b7280;
            --border: #e5e7eb;
        }

        
        .lp-nav {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 999;
            height: 70px;
            padding: 0 6%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(11, 21, 53, 0.5);
            backdrop-filter: blur(18px);
            border-bottom: 1px solid rgba(255,255,255,0.08);
            transition: background .3s ease;
        }
        .lp-nav.scrolled { background: rgba(11, 21, 53, 0.97); }

        .lp-brand { display: flex; align-items: center; gap: 11px; color: white; }
        .lp-brand img {
            width: 44px; height: 44px; border-radius: 50%;
            object-fit: cover;
            border: 2px solid rgba(255,255,255,0.25);
        }
        .lp-brand strong { font-size: 17px; font-weight: 800; color: white; display: block; line-height: 1.1; }
        .lp-brand span   { font-size: 10px; color: rgba(255,255,255,0.5); }

        .lp-links { display: flex; align-items: center; gap: 4px; }
        .lp-link  {
            padding: 8px 16px; border-radius: 8px;
            font-size: 13px; font-weight: 500;
            color: rgba(255,255,255,0.7); transition: .15s ease;
        }
        .lp-link:hover { color: white; background: rgba(255,255,255,0.1); }

        .lp-cta {
            padding: 10px 22px; border-radius: 9px;
            font-size: 13px; font-weight: 700;
            background: var(--blue); color: white;
            display: inline-flex; align-items: center; gap: 8px;
            box-shadow: 0 4px 16px rgba(30,58,138,0.5);
            transition: .2s ease;
        }
        .lp-cta:hover { background: var(--mid); color: white; transform: translateY(-1px); }

        
        .hero {
            position: relative;
            height: 100vh;
            min-height: 600px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        
        .hero-video-wrap {
            position: fixed;
            inset: 0;
            z-index: -1;          
            width: 100vw;
            height: 100vh;
        }
        .hero-video-wrap video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center center;
            display: block;
        }
        
        .hero-video-wrap::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(
                180deg,
                rgba(5, 10, 30, 0.50) 0%,
                rgba(5, 10, 30, 0.28) 40%,
                rgba(5, 10, 30, 0.28) 60%,
                rgba(5, 10, 30, 0.60) 100%
            );
        }

        
        .hero-video-cover {
            position: absolute;
            inset: 0;
            z-index: 1;
            background-image: url('/images/zpc1.jpeg');
            background-size: cover;
            background-position: center;
            opacity: 1;
            transition: opacity 0.9s ease;
        }
        .hero-video-cover.hidden {
            opacity: 0;
            pointer-events: none;
        }

        

        
        .hero-content {
            position: relative;
            z-index: 1;
            text-align: center;
            max-width: 780px;
            padding: 0 24px;
            padding-top: 70px; 
        }

        .hero-title {
            font-size: clamp(2.8rem, 6vw, 5rem);
            font-weight: 900;
            line-height: 1.04;
            letter-spacing: -2.5px;
            color: white;
            margin-bottom: 20px;
            text-shadow: 0 2px 28px rgba(0,0,0,0.6);
        }
        .hero-title .hl {
            display: block;
            background: linear-gradient(90deg, #60a5fa 0%, #34d399 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-sub {
            font-size: 17px;
            line-height: 1.8;
            color: rgba(255,255,255,0.80);
            max-width: 620px;
            margin: 0 auto 36px;
            text-shadow: 0 1px 6px rgba(0,0,0,0.4);
        }

        .hero-actions {
            display: flex;
            justify-content: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .btn-hero-primary {
            display: inline-flex; align-items: center; gap: 10px;
            padding: 18px 38px; border-radius: 12px;
            background: linear-gradient(135deg, #1C3B83 0%, #2952C8 100%);
            color: white;
            font-size: 16px; font-weight: 700;
            box-shadow: 0 8px 32px rgba(30,58,138,0.65),
                        inset 0 1px 0 rgba(255,255,255,0.15);
            transition: .25s ease;
            letter-spacing: 0.3px;
            border: 1px solid rgba(255,255,255,0.15);
        }
        .btn-hero-primary:hover {
            background: linear-gradient(135deg, #2952C8 0%, #3b82f6 100%);
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 14px 40px rgba(30,58,138,0.70);
        }

        .btn-hero-ghost {
            display: inline-flex; align-items: center; gap: 10px;
            padding: 17px 36px; border-radius: 12px;
            border: 2px solid rgba(255,255,255,0.85);
            background: rgba(255,255,255,0.10);
            color: white; font-size: 16px; font-weight: 700;
            transition: .25s ease;
            backdrop-filter: blur(10px);
            letter-spacing: 0.3px;
        }
        .btn-hero-ghost:hover {
            background: rgba(255,255,255,0.22);
            border-color: white;
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.2);
        }

        
        .stats-strip {
            position: relative;
            z-index: 1;
            background: var(--navy);
            padding: 44px 6%;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }
        .stat-item        { text-align: center; padding: 14px; }
        .stat-item strong { display: block; font-size: 2.2rem; font-weight: 900; color: white; line-height: 1; margin-bottom: 7px; }
        .stat-item span   { font-size: 12px; color: rgba(255,255,255,0.5); font-weight: 500; }
        .accent           { color: #34d399; }

        
        .section       { max-width: 1200px; margin: auto; padding: 90px 6%; }
        .section-label {
            display: inline-block;
            background: #ecfdf5; color: #059669;
            padding: 5px 12px; border-radius: 20px;
            font-size: 10px; font-weight: 800;
            text-transform: uppercase; letter-spacing: .08em;
            margin-bottom: 14px;
        }
        .section-heading     { max-width: 640px; margin-bottom: 52px; }
        .section-heading h2  { font-size: 2rem; font-weight: 800; line-height: 1.2; margin-bottom: 13px; }
        .section-heading p   { font-size: 15px; line-height: 1.75; color: var(--muted); }

        
        .features-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; }
        .feature-card {
            padding: 28px; border: 1px solid var(--border);
            border-radius: 16px; background: white; transition: .25s ease;
        }
        .feature-card:hover {
            transform: translateY(-5px);
            border-color: #bfdbfe;
            box-shadow: 0 16px 40px rgba(30,58,138,.08);
        }
        .feat-icon {
            width: 48px; height: 48px; border-radius: 12px;
            background: #eff6ff; color: var(--blue);
            display: flex; align-items: center; justify-content: center;
            font-size: 20px; margin-bottom: 18px;
        }
        .feature-card h3 { font-size: 15px; font-weight: 700; margin-bottom: 8px; }
        .feature-card p  { font-size: 13px; color: var(--muted); line-height: 1.7; }

        
        .how-bg { background: #f8faff; position: relative; z-index: 1; }
        .steps  { display: grid; grid-template-columns: repeat(4,1fr); gap: 20px; }
        .step   { text-align: center; position: relative; }
        .step-num {
            width: 52px; height: 52px; margin: 0 auto 18px;
            border-radius: 50%; background: var(--blue); color: white;
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; font-size: 16px;
            box-shadow: 0 6px 16px rgba(30,58,138,.3);
        }
        .step:not(:last-child)::after {
            content: ''; position: absolute;
            top: 26px; left: calc(50% + 32px); right: calc(-50% + 32px);
            height: 2px;
            background: linear-gradient(90deg, var(--blue), #bfdbfe);
        }
        .step h3 { font-size: 14px; font-weight: 700; margin-bottom: 7px; }
        .step p  { font-size: 12px; color: var(--muted); line-height: 1.6; }

        
        .roles-grid {
            display: grid; grid-template-columns: repeat(3,1fr); gap: 16px;
        }
        .role-card {
            padding: 28px 22px; border: 1px solid var(--border);
            border-radius: 16px; background: white;
            text-align: center; transition: .2s ease;
        }
        .role-card:hover {
            border-color: var(--blue); transform: translateY(-3px);
            box-shadow: 0 10px 28px rgba(30,58,138,.08);
        }
        .role-icon {
            width: 56px; height: 56px; border-radius: 14px;
            margin: 0 auto 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 22px;
        }
        .role-card h3 { font-size: 15px; font-weight: 700; margin-bottom: 8px; }
        .role-card p  { font-size: 13px; color: var(--muted); line-height: 1.6; }

        
        .cta-section {
            position: relative;
            z-index: 1;
            margin: 0 6% 80px; border-radius: 24px;
            background:
                radial-gradient(circle at 15% 20%, rgba(52,211,153,.12), transparent 25%),
                radial-gradient(circle at 90% 80%, rgba(59,130,246,.15), transparent 30%),
                var(--navy);
            padding: 80px 40px; text-align: center; color: white;
        }
        .cta-icon {
            width: 64px; height: 64px; margin: 0 auto 20px;
            border-radius: 16px; background: rgba(255,255,255,.1);
            display: flex; align-items: center; justify-content: center;
            font-size: 28px; color: #34d399;
        }
        .cta-section h2 { font-size: 2rem; font-weight: 800; margin-bottom: 14px; }
        .cta-section p  {
            max-width: 540px; margin: 0 auto 32px;
            color: rgba(255,255,255,.6); font-size: 15px; line-height: 1.75;
        }
        .btn-cta {
            display: inline-flex; align-items: center; gap: 9px;
            padding: 15px 32px; border-radius: 10px;
            background: #10b981; color: white;
            font-size: 15px; font-weight: 700;
            box-shadow: 0 6px 20px rgba(16,185,129,.3);
            transition: .2s ease;
        }
        .btn-cta:hover { background: #34d399; color: white; transform: translateY(-2px); }

        
        footer { position: relative; z-index: 1; background: #0A1230; color: white; padding: 60px 6% 28px; }
        .footer-grid {
            max-width: 1200px; margin: auto;
            display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr;
            gap: 60px; padding-bottom: 44px;
        }
        .footer-brand h3 { font-size: 16px; font-weight: 800; margin-bottom: 12px; }
        .footer-brand p  { color: #64748b; font-size: 12px; line-height: 1.75; max-width: 280px; }
        .footer-col h4   { font-size: 11px; text-transform: uppercase; letter-spacing: .08em; margin-bottom: 16px; color: #94a3b8; }
        .footer-col a    { display: block; color: #64748b; font-size: 12px; margin-bottom: 10px; transition: .15s; }
        .footer-col a:hover { color: white; }
        .footer-bottom {
            max-width: 1200px; margin: auto;
            padding-top: 22px; border-top: 1px solid rgba(255,255,255,.06);
            display: flex; justify-content: space-between;
            color: #475569; font-size: 11px;
        }

        
        @@media (max-width: 1024px) {
            .features-grid { grid-template-columns: repeat(2,1fr); }
            .stats-strip   { grid-template-columns: repeat(2,1fr); }
            .steps         { grid-template-columns: repeat(2,1fr); gap: 40px; }
            .step::after   { display: none; }
            .footer-grid   { grid-template-columns: 1fr 1fr; gap: 40px; }
        }
        @@media (max-width: 768px) {
            .lp-links      { display: none; }
            .hero-title    { font-size: 2.6rem; letter-spacing: -1.5px; }
            .features-grid { grid-template-columns: 1fr; }
            .roles-grid    { grid-template-columns: 1fr 1fr; }
            .stats-strip   { grid-template-columns: 1fr 1fr; }
            .footer-grid   { grid-template-columns: 1fr; gap: 30px; }
            .cta-section   { margin: 0 16px 60px; padding: 56px 20px; }
        }
        @@media (max-width: 520px) {
            .hero-actions  { flex-direction: column; align-items: center; }
            .roles-grid    { grid-template-columns: 1fr; }
            .steps         { grid-template-columns: 1fr; }
        }

    </style>
</head>
<body>

<nav class="lp-nav" id="navbar">
    <a href="/" class="lp-brand">
        <img src="/images/logo.jpeg" alt="UNILAK" />
        <div>
            <strong>CSAS</strong>
            <span>Course Schedule Awareness System</span>
        </div>
    </a>

    <div class="lp-links">
        <a href="#features" class="lp-link">Features</a>
        <a href="#how"      class="lp-link">How It Works</a>
        <a href="#roles"    class="lp-link">Roles</a>
    </div>

    <a href="https://umurongosmart.com/" target="_blank"
           style="display:inline-flex;align-items:center;gap:7px;
                  padding:8px 16px;border-radius:8px;
                  border:1px solid rgba(255,255,255,0.3);
                  background:rgba(255,255,255,0.08);
                  color:rgba(255,255,255,0.85);
                  font-size:12px;font-weight:600;
                  transition:.15s ease;text-decoration:none;"
           title="UmurongoSmart Support"
           onmouseover="this.style.background='rgba(255,255,255,0.18)'"
           onmouseout="this.style.background='rgba(255,255,255,0.08)'">
            <iconify-icon icon="mdi:headset-mic" style="font-size:14px;vertical-align:middle;"></iconify-icon> Support
        </a>

    <a href="/Login" class="lp-cta">
        <i class="bi bi-box-arrow-in-right"></i> Sign In
    </a>
</nav>

<section class="hero">

    <div class="hero-video-wrap">
        
        <div class="hero-video-cover" id="videoCover"></div>
        <video id="heroVideo" autoplay muted loop playsinline
               poster="/images/zpc1.jpeg"
               preload="auto">
            <source src="/images/Hero.mp4" type="video/mp4" />
        </video>
    </div>

    <div class="hero-content">

        <h1 class="hero-title">
            Smarter
            <span class="hl">Academic Scheduling</span>
            for Everyone.
        </h1>

        <p class="hero-sub">
            CSAS connects students, class representatives, lecturers and
            management through one secure platform — timetables, verified
            WhatsApp groups, mark management and quality monitoring in one place.
        </p>

        <div class="hero-actions">
            <a href="/Login" class="btn-hero-primary"><i class="bi bi-box-arrow-in-right"></i> Access Dashboard</a>
            <a href="#features" class="btn-hero-ghost"><i class="bi bi-play-circle-fill"></i> Learn More</a>
        </div>

    </div>
</section>

<div class="stats-strip">
    <div class="stat-item">
        <strong><span class="accent">6</span></strong>
        <span>Academic Roles</span>
    </div>
    <div class="stat-item">
        <strong>4</strong>
        <span>Departments Monitored</span>
    </div>
    <div class="stat-item">
        <strong><span class="accent">100%</span></strong>
        <span>Digital Approval Chain</span>
    </div>
    <div class="stat-item">
        <strong>Real-time</strong>
        <span>Schedule Synchronization</span>
    </div>
</div>

<div id="features">
    <div class="section">
        <div class="section-heading">
            <span class="section-label">Platform Features</span>
            <h2>Everything academic coordination needs.</h2>
            <p>
                From timetables to mark management to quality monitoring —
                CSAS brings it all under one verified, role-based platform.
            </p>
        </div>

        <div class="features-grid">
            <div class="feature-card">
                <div class="feat-icon"><i class="bi bi-calendar3-week"></i></div>
                <h3>Timetable Synchronization</h3>
                <p>Course schedules organized and synchronized across all departments with real-time delivery tracking.</p>
            </div>
            <div class="feature-card">
                <div class="feat-icon"><i class="bi bi-whatsapp"></i></div>
                <h3>Verified WhatsApp Groups</h3>
                <p>Students access official class communication groups with controlled joining deadlines managed by Class Reps.</p>
            </div>
            <div class="feature-card">
                <div class="feat-icon"><i class="bi bi-pencil-square"></i></div>
                <h3>Mark Management</h3>
                <p>Lecturers post assessment results directly to students. Students can view marks and raise claims for review.</p>
            </div>
            <div class="feature-card">
                <div class="feat-icon"><i class="bi bi-diagram-3-fill"></i></div>
                <h3>Multi-Level Approval Chain</h3>
                <p>Session reports flow from Lecturer → Class Rep → HOD → Dean, keeping every delivery verified and traceable.</p>
            </div>
            <div class="feature-card">
                <div class="feat-icon"><i class="bi bi-bar-chart-fill"></i></div>
                <h3>Quality Monitoring</h3>
                <p>The Director of Quality gets university-wide delivery reports with automatic flagging of below-threshold courses.</p>
            </div>
            <div class="feature-card">
                <div class="feat-icon"><i class="bi bi-person-lock"></i></div>
                <h3>Role-Based Access</h3>
                <p>Every role gets a dashboard tailored to their responsibilities — no more than what they need.</p>
            </div>
        </div>
    </div>
</div>

<div class="how-bg" id="how">
    <div class="section">
        <div class="section-heading">
            <span class="section-label">Simple Workflow</span>
            <h2>From session delivery to student awareness.</h2>
            <p>A clear process ensures academic information flows correctly through every level.</p>
        </div>

        <div class="steps">
            <div class="step">
                <div class="step-num">01</div>
                <h3>Lecturer Submits</h3>
                <p>After each session, the lecturer submits a delivery report with the topic covered and venue.</p>
            </div>
            <div class="step">
                <div class="step-num">02</div>
                <h3>CP Signs Off</h3>
                <p>The Class Representative confirms the session happened before it moves to the HOD.</p>
            </div>
            <div class="step">
                <div class="step-num">03</div>
                <h3>HOD &amp; Dean Approve</h3>
                <p>The Head of Department and Dean review and give final approval to the session report.</p>
            </div>
            <div class="step">
                <div class="step-num">04</div>
                <h3>Students Stay Informed</h3>
                <p>Verified schedules, marks and WhatsApp groups appear live on every student's dashboard.</p>
            </div>
        </div>
    </div>
</div>

<div id="roles">
    <div class="section">
        <div class="section-heading">
            <span class="section-label">Built for Every Academic Role</span>
            <h2>One platform. Six roles. Zero confusion.</h2>
            <p>Each role gets a custom dashboard with only the information and actions relevant to them.</p>
        </div>

        <div class="roles-grid">

            <div class="role-card">
                <div class="role-icon" style="background:#eff6ff;color:#1C3B83;">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <h3>Students</h3>
                <p>View timetable, check marks, raise claims and join verified WhatsApp groups before the deadline.</p>
            </div>

            <div class="role-card">
                <div class="role-icon" style="background:#f0fdfa;color:#0d9488;">
                    <i class="bi bi-person-badge-fill"></i>
                </div>
                <h3>Class Representatives</h3>
                <p>Sign off sessions, manage class WhatsApp groups and communicate with the HOD directly.</p>
            </div>

            <div class="role-card">
                <div class="role-icon" style="background:#f5f3ff;color:#7c3aed;">
                    <i class="bi bi-person-workspace"></i>
                </div>
                <h3>Lecturers</h3>
                <p>Submit session reports, post student marks and respond to mark claims raised by students.</p>
            </div>

            <div class="role-card">
                <div class="role-icon" style="background:#fffbeb;color:#d97706;">
                    <i class="bi bi-building"></i>
                </div>
                <h3>Head of Department</h3>
                <p>Add courses, manage rooms, review delivery rates and approve session reports.</p>
            </div>

            <div class="role-card">
                <div class="role-icon" style="background:#ecfdf5;color:#059669;">
                    <i class="bi bi-briefcase-fill"></i>
                </div>
                <h3>Dean</h3>
                <p>Oversee all departments in the faculty, give final approvals and monitor performance.</p>
            </div>

            <div class="role-card">
                <div class="role-icon" style="background:#fef2f2;color:#dc2626;">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <h3>Director of Quality</h3>
                <p>Monitor university-wide delivery, flag under-performing courses and generate audit reports.</p>
            </div>

        </div>
    </div>
</div>

<div class="cta-section">
    <div class="cta-icon"><i class="bi bi-mortarboard-fill"></i></div>
    <h2>Ready to access your academic portal?</h2>
    <p>
        Sign in with your UNILAK credentials to view your timetable, marks,
        verified communication channels and your role-specific dashboard.
    </p>
    <a href="/Login" class="btn-cta">
        <i class="bi bi-box-arrow-in-right"></i>
        Login to CSAS
    </a>
</div>

<footer>
    <div class="footer-grid">
        <div class="footer-brand">
            <h3>Course Schedule Awareness System</h3>
            <p>
                A centralized academic coordination platform for UNILAK —
                timetable awareness, mark management, communication and
                quality monitoring in one place.
            </p>
        </div>
        <div class="footer-col">
            <h4>Platform</h4>
            <a href="#features">Features</a>
            <a href="#how">How It Works</a>
            <a href="#roles">Academic Roles</a>
        </div>
        <div class="footer-col">
            <h4>Dashboards</h4>
