@page
@model CourseScheduleSystem.Web.Pages.HOD.DashboardModel
@{
    ViewData["Title"] = "HOD Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HOD Dashboard | CSAS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <style>
        /* ── Room Grid ─────────────────────────────────── */
        .room-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
            gap: 12px;
        }
        .room-card {
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 16px;
            background: white;
            transition: .2s ease;
            cursor: default;
        }
        .room-card:hover { box-shadow: 0 6px 18px rgba(30,58,138,.08); transform: translateY(-2px); }
        .room-card.unavailable { background: #fafafa; opacity: .7; }
        .room-card.has-conflict { border-color: #fca5a5; background: #fff5f5; }

        .room-badge {
            display: inline-block; padding: 3px 9px; border-radius: 20px;
            font-size: 10px; font-weight: 700; margin-bottom: 8px;
        }
        .rb-lecture    { background: #eff6ff; color: #1e3a8a; }
        .rb-lab        { background: #f5f3ff; color: #7c3aed; }
        .rb-computer   { background: #ecfdf5; color: #059669; }
        .rb-seminar    { background: #fffbeb; color: #d97706; }
        .rb-auditorium { background: #fef2f2; color: #dc2626; }
        .rb-unavailable { background: #f3f4f6; color: #6b7280; }

        .room-slots { margin-top: 10px; }
        .room-slot-item {
            display: flex; justify-content: space-between; align-items: center;
            padding: 5px 8px; border-radius: 6px; margin-bottom: 4px;
            font-size: 11px;
        }
        .slot-free   { background: #f0fdf4; color: #166534; }
        .slot-booked { background: #fef3c7; color: #92400e; }

        /* ── Conflict Warning ──────────────────────────── */
        .conflict-row { background: #fff5f5 !important; }
        .conflict-row td { border-left: 3px solid #dc2626; }

        /* ── Modal overlay ─────────────────────────────── */
        .hod-modal-overlay {
            display: none; position: fixed; inset: 0;
            background: rgba(0,0,0,.45); z-index: 3000;
            align-items: center; justify-content: center;
        }
        .hod-modal-overlay.open { display: flex; }
        .hod-modal {
            background: white; border-radius: 14px; padding: 28px;
            width: 100%; max-width: 560px; margin: 20px;
            box-shadow: 0 20px 50px rgba(0,0,0,.2);
            max-height: 90vh; overflow-y: auto;
        }
        .hod-modal-header {
            display: flex; justify-content: space-between;
            align-items: center; margin-bottom: 20px;
        }
        .hod-modal-header h5 { margin: 0; font-size: 16px; font-weight: 700; color: #0f1a3a; }
        .hod-close {
            background: none; border: none; font-size: 18px;
            color: #9ca3af; cursor: pointer; line-height: 1;
        }
        .hod-close:hover { color: #374151; }
        .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .form-field { margin-bottom: 14px; }
        .form-field label {
            display: block; font-size: 12px; font-weight: 600;
            color: #374151; margin-bottom: 5px;
        }
        .form-field input,
        .form-field select,
        .form-field textarea {
            width: 100%; padding: 9px 12px;
            border: 1px solid #d1d5db; border-radius: 7px;
            font-size: 13px; outline: none;
            transition: border-color .15s ease;
        }
        .form-field input:focus,
        .form-field select:focus,
        .form-field textarea:focus { border-color: #1e3a8a; }
        .form-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 4px; }

        /* ── Reject modal ──────────────────────────────── */
        #rejectModal .hod-modal { max-width: 420px; }

        /* ── Assign room modal ─────────────────────────── */
        #assignRoomModal .hod-modal { max-width: 480px; }
        .assign-room-item {
            display: flex; align-items: center; gap: 12px;
            padding: 12px; border: 1px solid #e5e7eb;
            border-radius: 8px; margin-bottom: 8px; cursor: pointer;
            transition: .15s ease;
        }
        .assign-room-item:hover { border-color: #1e3a8a; background: #f0f6ff; }
        .assign-room-item.conflict-room { opacity: .5; cursor: not-allowed; }
        .assign-room-item.conflict-room:hover { border-color: #e5e7eb; background: white; }
    </style>
</head>
<body>

<div class="dash-shell">

    <!-- =============================================
         SIDEBAR
    ============================================== -->
    <aside class="dash-sidebar">

        <a href="/" class="dash-sidebar-brand">
            <div class="dash-sidebar-brand-icon" style="background:transparent;box-shadow:none;padding:2px;"><img src="/images/logo.jpeg" alt="UNILAK" style="width:34px;height:34px;border-radius:50%;object-fit:cover;" /></div>
            <div class="dash-sidebar-brand-text">
                <strong>CSAS</strong>
                <span>HOD Portal</span>
            </div>
        </a>

        <div class="dash-sidebar-section">Main Menu</div>

        <nav class="dash-sidebar-nav">
            <a href="/" class="dash-nav-link">
                <i class="bi bi-house-fill"></i> Home
            </a>
            <a href="/HOD/Dashboard" class="dash-nav-link active">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a href="#section-courses" class="dash-nav-link">
                <i class="bi bi-journal-bookmark-fill"></i> Courses
            </a>
            <a href="#section-approvals" class="dash-nav-link">
                <i class="bi bi-check2-square"></i> Approve Sessions
                @if (Model.PendingApprovals > 0)
                {
                    <span style="margin-left:auto;background:#dc2626;color:white;
                                 font-size:10px;font-weight:700;padding:1px 7px;
                                 border-radius:20px;">@Model.PendingApprovals</span>
                }
            </a>
            <a href="#section-rooms" class="dash-nav-link">
                <i class="bi bi-door-open-fill"></i> Room Arrangement
            </a>
            <a href="#section-lecturers" class="dash-nav-link">
                <i class="bi bi-people-fill"></i> Lecturers
            </a>
            <a href="/HOD/Chat" class="dash-nav-link">
                <i class="bi bi-chat-dots-fill"></i> Messages to CPs
                @{
                    var unreadCount = CourseScheduleSystem.Web.Data.ChatData.UnreadCount(
                        Model.CurrentUser.Email, "HOD");
                }
                @if (unreadCount > 0)
                {
                    <span style="margin-left:auto;background:#dc2626;color:white;
                                 font-size:10px;font-weight:700;padding:1px 7px;
                                 border-radius:20px;">@unreadCount</span>
                }
            </a>
            <a href="#" class="dash-nav-link">
                <i class="bi bi-bell"></i> Notifications
            </a>
        </nav>

        <div class="dash-sidebar-section">Account</div>

        <nav class="dash-sidebar-nav">
            <a href="#" class="dash-nav-link">
                <i class="bi bi-person"></i> My Profile
            </a>
            <a href="/Logout" class="dash-nav-link">
                <i class="bi bi-box-arrow-left"></i> Logout
            </a>
        </nav>

        <div class="dash-sidebar-footer">
            <div class="dash-sidebar-user">
                <div class="dash-user-avatar">
                    <i class="bi bi-building"></i>
                </div>
                <div class="dash-user-info">
                    <strong>@Model.CurrentUser.FullName</strong>
                    <span>HOD · @Model.CurrentUser.Department</span>
                </div>
            </div>
        </div>

    </aside>


    <!-- =============================================
         MAIN CONTENT
    ============================================== -->
    <div class="dash-main">

        <!-- TOP BAR -->
        <div class="dash-topbar">
            <div class="dash-topbar-title">
                <h1>Head of Department Dashboard</h1>
                <p>@Model.CurrentUser.Department — Academic Overview</p>
            </div>
            <div class="dash-topbar-actions">
                <button class="btn-dash-primary btn-dash-sm" onclick="openModal('addCourseModal')">
                    <i class="bi bi-plus-lg"></i> Add Course
                </button>
                <a href="#" class="dash-icon-btn" title="Notifications">
                    <i class="bi bi-bell"></i>
                </a>
                <div class="dash-topbar-avatar">
                    <i class="bi bi-building"></i>
                </div>
            </div>
        </div>

        <!-- CONTENT -->
        <div class="dash-content">

            <!-- STATUS MESSAGE (after POST) -->
            @if (TempData["StatusMessage"] != null)
            {
                var type = TempData["StatusType"]?.ToString() ?? "info";
                var alertClass = type == "success" ? "dash-alert-success"
                               : type == "danger"  ? "dash-alert-danger"
                               : type == "warning" ? "dash-alert-warning"
                               : "dash-alert-info";
                var icon = type == "success" ? "bi-check-circle-fill"
                         : type == "danger"  ? "bi-x-circle-fill"
                         : type == "warning" ? "bi-exclamation-triangle-fill"
                         : "bi-info-circle-fill";
                <div class="dash-alert @alertClass">
                    <i class="bi @icon"></i>
                    <div>@TempData["StatusMessage"]</div>
                </div>
            }

            <!-- PENDING APPROVAL ALERT -->
            @if (Model.PendingApprovals > 0)
            {
                <div class="dash-alert dash-alert-info">
                    <i class="bi bi-info-circle-fill"></i>
                    <div>
                        <strong>Approval Required:</strong>
                        <strong>@Model.PendingApprovals session @(Model.PendingApprovals == 1 ? "report" : "reports")</strong>
                        signed off by Class Representatives — awaiting your approval.
                        <a href="#section-approvals" style="color:#1e3a8a;font-weight:700;margin-left:8px;">
                            Review now →
                        </a>
                    </div>
                </div>
            }

            <!-- STAT CARDS -->
            <div class="dash-stats dash-stats-4">

                <div class="dash-stat-card">
                    <div class="dash-stat-icon icon-blue">
                        <i class="bi bi-journal-bookmark-fill"></i>
                    </div>
                    <div class="dash-stat-body">
                        <strong>@Model.TotalCourses</strong>
                        <span>Courses in Department</span>
                    </div>
                </div>

                <div class="dash-stat-card">
                    <div class="dash-stat-icon icon-teal">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div class="dash-stat-body">
                        <strong>@Model.TotalLecturers</strong>
                        <span>Active Lecturers</span>
                    </div>
                </div>

                <div class="dash-stat-card">
                    <div class="dash-stat-icon icon-amber">
                        <i class="bi bi-check2-square"></i>
                    </div>
                    <div class="dash-stat-body">
                        <strong>@Model.PendingApprovals</strong>
                        <span>Sessions to Approve</span>
                    </div>
                </div>

                <div class="dash-stat-card">
                    <div class="dash-stat-icon @(Model.DeptDeliveryRate >= 80 ? "icon-green" : "icon-amber")">
                        <i class="bi bi-bar-chart-fill"></i>
                    </div>
                    <div class="dash-stat-body">
                        <strong>@Model.DeptDeliveryRate%</strong>
                        <span>Dept. Delivery Rate</span>
                    </div>
                </div>

            </div>


            <!-- =============================================
                 COURSES TABLE
            ============================================== -->
            <div class="dash-card" id="section-courses">
                <div class="dash-card-header">
                    <div>
                        <h5>Department Courses</h5>
                        <p>All courses — click a room to reassign</p>
                    </div>
                    <div style="display:flex;gap:8px;">
                        <a href="#" class="btn-dash-outline btn-dash-sm">
                            <i class="bi bi-download"></i> Export
                        </a>
                        <button class="btn-dash-primary btn-dash-sm" onclick="openModal('addCourseModal')">
                            <i class="bi bi-plus-lg"></i> Add Course
                        </button>
                    </div>
                </div>
                <div class="dash-card-body" style="padding:0;">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>Course</th>
                                <th>Lecturer</th>
                                <th>Schedule</th>
                                <th>Venue</th>
                                <th>Progress</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Courses)
                            {
                                var pct = c.ScheduledHours > 0
                                    ? (double)c.DeliveredHours / c.ScheduledHours * 100
                                    : 0;
                                var barColor = pct >= 90 ? "#059669"
                                             : pct >= 70 ? "#1e3a8a"
                                             : pct >= 50 ? "#d97706"
                                             : "#dc2626";
                                var statusBadge = pct >= 100 ? ("badge-approved", "bi-patch-check-fill", "Complete")
                                               : pct >= 70  ? ("badge-verified", "bi-check-circle-fill", "On Track")
                                               : pct >= 50  ? ("badge-pending", "bi-clock-history", "In Progress")
                                               : ("badge-missed", "bi-exclamation-circle-fill", "Behind");

                                // Detect room conflict
                                var conflict = Model.Courses.Any(other =>
                                    other.Id != c.Id &&
                                    !string.IsNullOrEmpty(c.Venue) &&
                                    !string.IsNullOrEmpty(c.ScheduleTime) &&
                                    other.Venue == c.Venue &&
                                    other.ScheduleTime == c.ScheduleTime);

                                <tr class="@(conflict ? "conflict-row" : "")">
                                    <td>
                                        <strong style="display:block;font-size:13px;">@c.Code</strong>
                                        <span style="font-size:11px;color:#9ca3af;">@c.Title</span>
                                    </td>
                                    <td style="font-size:12px;">@c.Lecturer</td>
                                    <td style="font-size:12px;">@c.ScheduleTime</td>
                                    <td>
                                        <button onclick="openAssignRoom(@c.Id, '@c.Code', '@c.ScheduleTime')"
                                                style="background:none;border:none;cursor:pointer;
                                                       font-size:12px;color:#1e3a8a;font-weight:600;
                                                       text-decoration:underline;padding:0;">
                                            @(string.IsNullOrEmpty(c.Venue) ? "— Assign Room" : c.Venue)
                                        </button>
                                        @if (conflict)
                                        {
                                            <span style="display:block;font-size:10px;color:#dc2626;
                                                         font-weight:600;margin-top:2px;">
                                                <i class="bi bi-exclamation-triangle-fill"></i> Conflict!
                                            </span>
                                        }
                                    </td>
                                    <td style="min-width:110px;">
                                        <div style="display:flex;align-items:center;gap:6px;">
                                            <div style="flex:1;height:5px;background:#f1f5f9;
                                                        border-radius:5px;overflow:hidden;">
                                                <div style="width:@(pct.ToString("F0"))%;height:100%;
                                                            background:@barColor;border-radius:5px;"></div>
                                            </div>
                                            <span style="font-size:10px;font-weight:700;color:@barColor;
                                                         white-space:nowrap;">
                                                @c.DeliveredHours/@c.ScheduledHours h
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge-status @statusBadge.Item1">
                                            <i class="bi @statusBadge.Item2"></i>
                                            @statusBadge.Item3
                                        </span>
                                    </td>
                                    <td>
                                        <div style="display:flex;gap:5px;">
                                            <button class="btn-dash-icon" title="View details">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button class="btn-dash-icon" title="Edit course">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>


            <!-- =============================================
                 SESSIONS AWAITING HOD APPROVAL
            ============================================== -->
            <div class="dash-card" id="section-approvals">
                <div class="dash-card-header">
                    <div>
                        <h5>Sessions Awaiting HOD Approval</h5>
                        <p>Signed off by Class Representatives — approve to forward to the Dean</p>
                    </div>
                    @if (Model.PendingApprovals == 0)
                    {
                        <span class="badge-status badge-approved">
                            <i class="bi bi-check-circle-fill"></i> All clear
                        </span>
                    }
                </div>

                @if (!Model.AwaitingApproval.Any())
                {
                    <div class="dash-empty">
                        <i class="bi bi-check2-circle"></i>
                        <p>No sessions waiting for approval. All up to date.</p>
                    </div>
                }
                else
                {
                    <div class="dash-card-body" style="padding:0;">
                        <table class="dash-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Course</th>
                                    <th>Lecturer</th>
                                    <th>Topic Covered</th>
                                    <th>CP Sign-Off</th>
                                    <th>Duration</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.AwaitingApproval)
                                {
                                    <tr>
                                        <td style="font-size:12px;">
                                            @r.SessionDate.ToString("ddd dd MMM")
                                        </td>
                                        <td>
                                            <strong style="display:block;font-size:13px;">@r.CourseCode</strong>
                                            <span style="font-size:11px;color:#9ca3af;">@r.CourseTitle</span>
                                        </td>
                                        <td style="font-size:12px;">@r.LecturerName</td>
                                        <td style="font-size:12px;max-width:150px;">
                                            @(string.IsNullOrEmpty(r.TopicCovered) ? "—" : r.TopicCovered)
                                        </td>
                                        <td>
                                            <span class="badge-status badge-verified">
                                                <i class="bi bi-check-circle-fill"></i>
                                                @r.ClassRepresentativeName
                                            </span>
                                        </td>
                                        <td style="font-size:12px;">@r.DurationHours hrs</td>
                                        <td>
                                            <div style="display:flex;gap:6px;flex-wrap:wrap;">

                                                <!-- APPROVE form -->
                                                <form method="post"
                                                      asp-page-handler="ApproveSession"
                                                      style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="reportId" value="@r.Id" />
                                                    <button type="submit" class="btn-dash-primary btn-dash-sm">
                                                        <i class="bi bi-check-lg"></i> Approve
                                                    </button>
                                                </form>

                                                <!-- REJECT — opens modal -->
                                                <button class="btn-dash-outline btn-dash-sm"
                                                        style="color:#dc2626;border-color:#fecaca;"
                                                        onclick="openRejectModal(@r.Id, '@r.CourseCode', '@r.SessionDate.ToString("dd MMM")')">
                                                    <i class="bi bi-x-lg"></i> Reject
                                                </button>

                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>


            <!-- =============================================
                 ROOM ARRANGEMENT
            ============================================== -->
            <div class="dash-card" id="section-rooms">
                <div class="dash-card-header">
                    <div>
                        <h5>Room Arrangement</h5>
                        <p>Campus venues — booked slots, capacity and availability at a glance</p>
                    </div>
                    <div style="display:flex;gap:8px;align-items:center;">
                        <span style="font-size:11px;display:flex;align-items:center;gap:4px;">
                            <span style="width:10px;height:10px;border-radius:50%;background:#ecfdf5;border:1px solid #059669;display:inline-block;"></span> Free
                        </span>
                        <span style="font-size:11px;display:flex;align-items:center;gap:4px;">
                            <span style="width:10px;height:10px;border-radius:50%;background:#fef3c7;border:1px solid #d97706;display:inline-block;"></span> Booked
                        </span>
                        <span style="font-size:11px;display:flex;align-items:center;gap:4px;">
                            <span style="width:10px;height:10px;border-radius:50%;background:#f3f4f6;border:1px solid #9ca3af;display:inline-block;"></span> Unavailable
                        </span>
                    </div>
                </div>
                <div class="dash-card-body">

                    @foreach (var block in Model.Rooms.GroupBy(r => r.Block).OrderBy(g => g.Key))
                    {
                        <div style="margin-bottom:24px;">
                            <div style="font-size:11px;font-weight:700;color:#1e3a8a;
                                        text-transform:uppercase;letter-spacing:.08em;
                                        margin-bottom:12px;padding-bottom:6px;
                                        border-bottom:1px solid #e5e7eb;">
                                <i class="bi bi-building-fill" style="margin-right:6px;"></i>
                                @block.Key
                            </div>

                            <div class="room-grid">
                                @foreach (var room in block.OrderBy(r => r.Number))
                                {
                                    var typeClass = room.Type switch {
                                        CourseScheduleSystem.Web.Models.RoomType.Laboratory   => "rb-lab",
                                        CourseScheduleSystem.Web.Models.RoomType.ComputerLab  => "rb-computer",
                                        CourseScheduleSystem.Web.Models.RoomType.Seminar      => "rb-seminar",
                                        CourseScheduleSystem.Web.Models.RoomType.Auditorium   => "rb-auditorium",
                                        _                                                      => "rb-lecture"
                                    };
                                    var cardClass = !room.IsAvailable ? "unavailable" : "";

                                    <div class="room-card @cardClass">

                                        <!-- Header row -->
                                        <div style="display:flex;justify-content:space-between;
                                                    align-items:flex-start;margin-bottom:4px;">
                                            <div>
                                                <span class="room-badge @(room.IsAvailable ? typeClass : "rb-unavailable")">
                                                    @room.Type
                                                </span>
                                                <div style="font-size:14px;font-weight:700;
                                                            color:#0f1a3a;">@room.Number</div>
                                            </div>
                                            <div style="text-align:right;">
                                                <div style="font-size:11px;color:#6b7280;">
                                                    <i class="bi bi-people-fill"></i> @room.Capacity
                                                </div>
                                                @if (!room.IsAvailable)
                                                {
                                                    <span style="font-size:9px;color:#dc2626;
                                                                 font-weight:700;">UNAVAILABLE</span>
                                                }
                                                else if (room.BookedSlots.Count == 0)
                                                {
                                                    <span style="font-size:9px;color:#059669;
                                                                 font-weight:700;">ALL FREE</span>
                                                }
                                            </div>
                                        </div>

                                        <!-- Booked slots -->
                                        @if (room.BookedSlots.Any())
                                        {
                                            <div class="room-slots">
                                                @foreach (var slot in room.BookedSlots)
                                                {
                                                    <div class="room-slot-item slot-booked">
                                                        <span><i class="bi bi-clock-fill" style="margin-right:4px;"></i>@slot.Key</span>
                                                        <span style="font-weight:700;">@slot.Value</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (room.IsAvailable)
                                        {
                                            <div class="room-slot-item slot-free" style="margin-top:8px;">
                                                <span><i class="bi bi-calendar-check" style="margin-right:4px;"></i>No sessions booked</span>
                                            </div>
                                        }

                                        <!-- Notes -->
                                        @if (!string.IsNullOrEmpty(room.Notes))
                                        {
                                            <div style="margin-top:8px;font-size:10px;
                                                        color:#9ca3af;font-style:italic;">
                                                <i class="bi bi-info-circle"></i> @room.Notes
                                            </div>
                                        }

                                    </div>
                                }
                            </div>
                        </div>
                    }

                </div>
            </div>


            <!-- =============================================
                 DELIVERY PROGRESS
            ============================================== -->
            <div class="dash-card">
                <div class="dash-card-header">
                    <div>
                        <h5>Delivery Progress per Course</h5>
                        <p>Hours delivered vs scheduled this semester</p>
                    </div>
                </div>
                <div class="dash-card-body">
                    @foreach (var c in Model.Courses)
                    {
                        var pct = c.ScheduledHours > 0
                            ? Math.Round((double)c.DeliveredHours / c.ScheduledHours * 100, 0)
                            : 0;
                        var barColor = pct >= 90 ? "#059669"
                                     : pct >= 70 ? "#1e3a8a"
                                     : pct >= 50 ? "#d97706"
                                     : "#dc2626";
                        <div class="dash-progress-row">
                            <span class="dash-progress-label">@c.Code – @c.Title</span>
                            <div class="dash-progress-bar-wrap">
                                <div class="dash-progress-bar-fill"
                                     style="width:@(pct)%;background:@barColor;"></div>
                            </div>
                            <span class="dash-progress-pct">@pct%</span>
                        </div>
                    }
                </div>
            </div>


            <!-- =============================================
                 LECTURERS
            ============================================== -->
            <div class="dash-card" id="section-lecturers">
                <div class="dash-card-header">
                    <div>
                        <h5>Lecturers</h5>
                        <p>Teaching staff in your department</p>
                    </div>
                    <button class="btn-dash-primary btn-dash-sm" onclick="openModal('addLecturerModal')">
                        <i class="bi bi-plus-lg"></i> Add Lecturer
                    </button>
                </div>
                <div class="dash-card-body" style="padding:0;">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Courses</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in Model.Lecturers)
                            {
                                var courseCount = Model.Courses.Count(c =>
                                    c.Lecturer.Contains(l.LastName, StringComparison.OrdinalIgnoreCase));
                                <tr>
                                    <td>
                                        <strong style="font-size:13px;">@l.FullName</strong>
                                    </td>
                                    <td style="font-size:12px;color:#6b7280;">@l.Email</td>
                                    <td>
                                        <span class="badge-status badge-active">
                                            @courseCount course@(courseCount != 1 ? "s" : "")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge-status @(l.IsActive ? "badge-verified" : "badge-inactive")">
                                            @(l.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>
                                        <div style="display:flex;gap:5px;">
                                            <button class="btn-dash-icon" title="View profile">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button class="btn-dash-icon" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
        <!-- /dash-content -->
    </div>
    <!-- /dash-main -->

</div>
<!-- /dash-shell -->


<!-- =====================================================
     MODAL 1 — ADD COURSE
====================================================== -->
<div id="addCourseModal" class="hod-modal-overlay">
    <div class="hod-modal">
        <div class="hod-modal-header">
            <h5><i class="bi bi-journal-plus" style="color:#1e3a8a;margin-right:8px;"></i>Add New Course</h5>
            <button class="hod-close" onclick="closeModal('addCourseModal')">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="dash-alert dash-alert-info" style="margin-bottom:16px;">
            <i class="bi bi-info-circle-fill"></i>
            <div style="font-size:12px;">
                Room conflicts are checked automatically. If the selected room is already booked
                at the chosen time, the course will not be saved.
            </div>
        </div>

        <form method="post" asp-page-handler="AddCourse">
            @Html.AntiForgeryToken()

            <div class="form-row-2">
                <div class="form-field">
                    <label>Course Code <span style="color:#dc2626;">*</span></label>
                    <input type="text" name="code" placeholder="e.g. CSE415" required />
                </div>
                <div class="form-field">
                    <label>Year / Level</label>
                    <select name="year">
                        <option value="1">Year 1</option>
                        <option value="2">Year 2</option>
                        <option value="3" selected>Year 3</option>
                        <option value="4">Year 4</option>
                    </select>
                </div>
            </div>

            <div class="form-field">
                <label>Course Title <span style="color:#dc2626;">*</span></label>
                <input type="text" name="title" placeholder="e.g. Advanced Algorithms" required />
            </div>

            <div class="form-row-2">
                <div class="form-field">
                    <label>Assigned Lecturer</label>
                    <select name="lecturer">
                        <option value="">— Select Lecturer —</option>
                        @foreach (var l in Model.Lecturers)
                        {
                            <option value="@l.FullName">@l.FullName</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label>Semester</label>
                    <select name="semester">
                        <option value="1" selected>Semester 1</option>
                        <option value="2">Semester 2</option>
                    </select>
                </div>
            </div>

            <div class="form-row-2">
                <div class="form-field">
                    <label>Schedule Time</label>
                    <select name="scheduleTime">
                        <option value="">— Select Slot —</option>
                        <option>Mon 08:00 - 10:00</option>
                        <option>Mon 10:00 - 12:00</option>
                        <option>Mon 13:00 - 15:00</option>
                        <option>Tue 08:00 - 10:00</option>
                        <option>Tue 10:00 - 12:00</option>
                        <option>Tue 13:00 - 15:00</option>
                        <option>Wed 08:00 - 10:00</option>
                        <option>Wed 10:00 - 12:00</option>
                        <option>Wed 13:00 - 15:00</option>
                        <option>Thu 08:00 - 10:00</option>
                        <option>Thu 10:00 - 12:00</option>
                        <option>Thu 13:00 - 15:00</option>
                        <option>Fri 08:00 - 10:00</option>
                        <option>Fri 10:00 - 12:00</option>
                        <option>Fri 13:00 - 15:00</option>
                    </select>
                </div>
                <div class="form-field">
                    <label>Venue / Room</label>
                    <select name="venue">
                        <option value="">— Select Room —</option>
                        @foreach (var r in Model.AvailableRooms)
                        {
                            <option value="@r.FullName">
                                @r.FullName (@r.Type, cap. @r.Capacity)
                                @(r.BookedSlots.Any() ? "— " + r.BookedSlots.Count + " slot(s) booked" : "— Free")
                            </option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-row-2">
                <div class="form-field">
                    <label>Scheduled Hours</label>
                    <input type="number" name="scheduledHours" value="36" min="1" max="120" />
                </div>
                <div class="form-field">
                    <label style="color:#9ca3af;">WhatsApp Group</label>
                    <div style="padding:9px 12px;background:#f8fafc;border:1px solid #e5e7eb;
                                border-radius:7px;font-size:12px;color:#9ca3af;">
                        <i class="bi bi-info-circle"></i>
                        Set by the Class Representative after course creation.
                    </div>
                </div>
            </div>
            <!-- hidden empty value so the POST handler still receives whatsappUrl -->
            <input type="hidden" name="whatsappUrl" value="" />

            <div class="form-actions">
                <button type="button" class="btn-dash-outline" onclick="closeModal('addCourseModal')">
                    Cancel
                </button>
                <button type="submit" class="btn-dash-primary">
                    <i class="bi bi-plus-lg"></i> Add Course
                </button>
            </div>
        </form>
    </div>
</div>


<!-- =====================================================
     MODAL 2 — REJECT SESSION
====================================================== -->
<div id="rejectModal" class="hod-modal-overlay">
    <div class="hod-modal">
        <div class="hod-modal-header">
            <h5><i class="bi bi-x-circle-fill" style="color:#dc2626;margin-right:8px;"></i>Reject Session Report</h5>
            <button class="hod-close" onclick="closeModal('rejectModal')">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <p id="rejectModalDesc" style="font-size:13px;color:#6b7280;margin-bottom:16px;"></p>
        <form method="post" asp-page-handler="RejectSession" id="rejectForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="reportId" id="rejectReportId" />
            <div class="form-field">
                <label>Reason for Rejection <span style="color:#dc2626;">*</span></label>
                <textarea name="reason" id="rejectReason" rows="3" required
                          placeholder="Explain why this session report is being returned..."></textarea>
            </div>
            <div class="form-actions">
                <button type="button" class="btn-dash-outline" onclick="closeModal('rejectModal')">
                    Cancel
                </button>
                <button type="submit" class="btn-dash-primary" style="background:#dc2626;">
                    <i class="bi bi-x-lg"></i> Confirm Rejection
                </button>
            </div>
        </form>
    </div>
</div>


<!-- =====================================================
     MODAL 3 — ASSIGN ROOM
====================================================== -->
<div id="assignRoomModal" class="hod-modal-overlay">
    <div class="hod-modal">
        <div class="hod-modal-header">
            <h5><i class="bi bi-door-open-fill" style="color:#1e3a8a;margin-right:8px;"></i>Assign Room</h5>
            <button class="hod-close" onclick="closeModal('assignRoomModal')">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <p id="assignRoomDesc" style="font-size:13px;color:#6b7280;margin-bottom:14px;"></p>
        <div id="assignRoomList"></div>
    </div>
</div>


<!-- =====================================================
     MODAL 4 — ADD LECTURER
====================================================== -->
<div id="addLecturerModal" class="hod-modal-overlay">
    <div class="hod-modal">
        <div class="hod-modal-header">
            <h5><i class="bi bi-person-plus-fill" style="color:#1e3a8a;margin-right:8px;"></i>Add Lecturer</h5>
            <button class="hod-close" onclick="closeModal('addLecturerModal')">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <form onsubmit="submitAddLecturer(event)">
            <div class="form-row-2">
                <div class="form-field">
                    <label>First Name <span style="color:#dc2626;">*</span></label>
                    <input type="text" id="lec-fname" placeholder="e.g. Paul" required />
                </div>
                <div class="form-field">
                    <label>Last Name <span style="color:#dc2626;">*</span></label>
                    <input type="text" id="lec-lname" placeholder="e.g. Habimana" required />
                </div>
            </div>
            <div class="form-field">
                <label>Email <span style="color:#dc2626;">*</span></label>
                <input type="email" id="lec-email" placeholder="e.g. p.habimana@unilak.ac.rw" required />
            </div>
            <div class="form-row-2">
                <div class="form-field">
                    <label>Staff ID</label>
                    <input type="text" id="lec-staff" placeholder="e.g. STAFF/012" />
                </div>
                <div class="form-field">
                    <label>Title</label>
                    <select id="lec-title">
                        <option>Dr.</option>
                        <option>Prof.</option>
                        <option>Mr.</option>
                        <option>Mrs.</option>
                        <option>Ms.</option>
                    </select>
                </div>
            </div>
            <div class="dash-alert dash-alert-info" style="margin:4px 0 14px;">
                <i class="bi bi-info-circle-fill"></i>
                <div style="font-size:12px;">
                    A temporary password <strong>lecturer123</strong> will be assigned.
                    The lecturer can change it after first login.
                </div>
            </div>
            <div class="form-actions">
                <button type="button" class="btn-dash-outline" onclick="closeModal('addLecturerModal')">
                    Cancel
                </button>
                <button type="submit" class="btn-dash-primary">
                    <i class="bi bi-person-plus-fill"></i> Add Lecturer
                </button>
            </div>
        </form>
    </div>
</div>


<!-- =====================================================
     ROOM DATA for JS (assign modal)
====================================================== -->
<div id="roomDataStore" style="display:none;">
    @foreach (var r in Model.AvailableRooms)
    {
        <div class="room-data-item"
             data-id="@r.Id"
             data-name="@r.FullName"
             data-type="@r.Type"
             data-capacity="@r.Capacity"
             data-slots="@string.Join('|', r.BookedSlots.Select(s => s.Key + "=" + s.Value))">
        </div>
    }
</div>


<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    /* ── Modal helpers ───────────────────────────────── */
    function openModal(id) {
        document.getElementById(id).classList.add('open');
    }
    function closeModal(id) {
        document.getElementById(id).classList.remove('open');
    }
    // Close on backdrop click
    document.querySelectorAll('.hod-modal-overlay').forEach(function(overlay) {
        overlay.addEventListener('click', function(e) {
            if (e.target === overlay) overlay.classList.remove('open');
        });
    });

    /* ── Reject modal ────────────────────────────────── */
    function openRejectModal(reportId, courseCode, date) {
        document.getElementById('rejectReportId').value = reportId;
        document.getElementById('rejectReason').value   = '';
        document.getElementById('rejectModalDesc').textContent =
            'You are rejecting the session report for ' + courseCode + ' on ' + date + '.';
        openModal('rejectModal');
    }

    /* ── Assign Room modal ───────────────────────────── */
    function openAssignRoom(courseId, courseCode, scheduleTime) {
        document.getElementById('assignRoomDesc').textContent =
            'Select a room for ' + courseCode +
            (scheduleTime ? ' (' + scheduleTime + ')' : '') +
            '. Rooms with a conflict at that time are shown as unavailable.';

        var list = document.getElementById('assignRoomList');
        list.innerHTML = '';

        var items = document.querySelectorAll('#roomDataStore .room-data-item');

        items.forEach(function(item) {
            var slots    = item.dataset.slots ? item.dataset.slots.split('|') : [];
            var bookedAt = {};
            slots.forEach(function(s) {
                if (s) {
                    var parts = s.split('=');
                    if (parts.length === 2) bookedAt[parts[0].trim()] = parts[1].trim();
                }
            });

            var hasConflict = scheduleTime && bookedAt.hasOwnProperty(scheduleTime.trim());
            var div         = document.createElement('div');
            div.className   = 'assign-room-item' + (hasConflict ? ' conflict-room' : '');

            var slotInfo = hasConflict
                ? '<span style="font-size:11px;color:#dc2626;font-weight:600;">' +
                  '⚠ Booked for ' + bookedAt[scheduleTime.trim()] + ' at this time</span>'
                : '<span style="font-size:11px;color:#059669;font-weight:600;">✓ Available</span>';

            div.innerHTML =
                '<div style="width:40px;height:40px;border-radius:10px;background:#eff6ff;' +
                'color:#1e3a8a;display:flex;align-items:center;justify-content:center;' +
                'font-size:16px;flex-shrink:0;"><i class="bi bi-door-open-fill"></i></div>' +
                '<div style="flex:1;">' +
                '<strong style="font-size:13px;">' + item.dataset.name + '</strong>' +
                '<div style="font-size:11px;color:#6b7280;">' +
                item.dataset.type + ' · Cap. ' + item.dataset.capacity + '</div>' +
                slotInfo +
                '</div>';

            if (!hasConflict) {
                div.addEventListener('click', function() {
                    submitAssignRoom(courseId, parseInt(item.dataset.id));
                });
            }

            list.appendChild(div);
        });

        openModal('assignRoomModal');
    }

    function submitAssignRoom(courseId, roomId) {
        var form = document.createElement('form');
        form.method = 'post';
        form.action = '?handler=AssignRoom';

        var token = document.querySelector('input[name="__RequestVerificationToken"]');
        if (token) {
            var t = document.createElement('input');
            t.type  = 'hidden';
            t.name  = '__RequestVerificationToken';
            t.value = token.value;
            form.appendChild(t);
        }

        function addField(name, val) {
            var i = document.createElement('input');
            i.type  = 'hidden';
            i.name  = name;
            i.value = val;
            form.appendChild(i);
        }

        addField('courseId', courseId);
        addField('roomId',   roomId);

        document.body.appendChild(form);
        form.submit();
    }

    /* ── Add Lecturer (client-side only for now) ─────── */
    function submitAddLecturer(e) {
        e.preventDefault();
        closeModal('addLecturerModal');
        showToast('✓ Lecturer added successfully (demo — backend pending).');
    }

    /* ── Toast ───────────────────────────────────────── */
    function showToast(msg) {
        var t = document.createElement('div');
        t.textContent = msg;
        t.style.cssText =
            'position:fixed;bottom:24px;right:24px;background:#059669;color:white;' +
            'padding:14px 20px;border-radius:10px;font-size:13px;font-weight:600;' +
            'z-index:9999;box-shadow:0 8px 20px rgba(0,0,0,.15);';
        document.body.appendChild(t);
        setTimeout(function() { t.remove(); }, 4000);
    }
</script>
</body>
</html>
