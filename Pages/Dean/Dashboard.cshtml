@page
@model CourseScheduleSystem.Web.Pages.Dean.DashboardModel
@{
    ViewData["Title"] = "Dean Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dean Dashboard | CSAS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>

<div class="dash-shell">

    
    <aside class="dash-sidebar">

        <a href="/" class="dash-sidebar-brand">
            <div class="dash-sidebar-brand-icon" style="background:transparent;box-shadow:none;padding:2px;"><img src="/images/logo.jpeg" alt="UNILAK" style="width:34px;height:34px;border-radius:50%;object-fit:cover;" /></div>
            <div class="dash-sidebar-brand-text">
                <strong>CSAS</strong>
                <span>Dean Portal</span>
            </div>
        </a>

        <div class="dash-sidebar-section">Main Menu</div>

        <nav class="dash-sidebar-nav">
            <a href="/" class="dash-nav-link">
                <i class="bi bi-house-fill"></i> Home
            </a>
            <a href="/Dean/Dashboard" class="dash-nav-link active">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a href="#section-depts" class="dash-nav-link" onclick="revealAndScroll('section-depts')">
                <i class="bi bi-diagram-3-fill"></i> All Departments
            </a>
            <a href="#section-approvals" class="dash-nav-link" onclick="revealAndScroll('section-approvals')">
                <i class="bi bi-check2-square"></i> Final Approvals
                @if (Model.PendingFinalApprovals > 0)
                {
                    <span style="margin-left:auto;background:#dc2626;color:white;font-size:10px;font-weight:700;padding:1px 7px;border-radius:20px;">@Model.PendingFinalApprovals</span>
                }
            </a>
            <a href="#section-delivery" class="dash-nav-link" onclick="revealAndScroll('section-delivery')">
                <i class="bi bi-bar-chart-fill"></i> Faculty Delivery
            </a>
            <a href="#section-activity" class="dash-nav-link" onclick="revealAndScroll('section-activity')">
                <i class="bi bi-clock-history"></i> Recent Activity
            </a>
            <a href="#section-audit" class="dash-nav-link" onclick="revealAndScroll('section-audit')">
                <i class="bi bi-journal-text"></i> Audit Log
            </a>
            <a href="https://umurongosmart.com/" target="_blank" class="dash-nav-link"
               style="border-top:1px solid rgba(255,255,255,0.07);margin-top:4px;padding-top:12px;">
                <iconify-icon icon="mdi:headset-mic" style="font-size:16px;vertical-align:middle;"></iconify-icon> UmurongoSmart Support
            </a>
        </nav>

        <div class="dash-sidebar-section">Account</div>
        <nav class="dash-sidebar-nav">
            <a href="/Profile" class="dash-nav-link"><i class="bi bi-person"></i> My Profile</a>
            <a href="/Logout" class="dash-nav-link"><i class="bi bi-box-arrow-left"></i> Logout</a>
        </nav>

        <div class="dash-sidebar-footer">
            <div class="dash-sidebar-user">
                <div class="dash-user-avatar">
                    <i class="bi bi-briefcase-fill"></i>
                </div>
                <div class="dash-user-info">
                    <strong>@Model.CurrentUser.FullName</strong>
                    <span>Dean &middot; @Model.CurrentUser.Department</span>
                </div>
            </div>
        </div>

    </aside>

    
    <div class="dash-main">

        <div class="dash-topbar">
            <div class="dash-topbar-title">
                <h1>Dean Dashboard</h1>
                <p>Welcome, @Model.CurrentUser.FirstName &mdash; Faculty academic oversight</p>
            </div>
            <div class="dash-topbar-actions">
                <a href="/Dean/Dashboard" class="dash-icon-btn" title="Notifications">
                    <i class="bi bi-bell"></i>
                </a>
                <div class="dash-topbar-avatar">
                    <i class="bi bi-briefcase-fill"></i>
                </div>
            </div>
        </div>

        
        <div class="dash-content">

            
            @if (TempData["StatusMessage"] != null)
            {
                var type = TempData["StatusType"]?.ToString() ?? "info";
                var alertClass = type == "success" ? "dash-alert-success"
                               : type == "danger"  ? "dash-alert-danger"
                               : type == "warning" ? "dash-alert-warning"
                               : "dash-alert-info";
                var icon = type == "success" ? "bi-check-circle-fill"
                         : type == "danger"  ? "bi-x-circle-fill"
                         : "bi-exclamation-triangle-fill";
                <div class="dash-alert @alertClass">
                    <i class="bi @icon"></i>
                    <div>@TempData["StatusMessage"]</div>
                </div>
            }

            @if (Model.EscalatedIssues.Any())
            {
                <div class="dash-alert dash-alert-danger" style="margin-bottom:16px;">
                    <i class="bi bi-bug-fill"></i>
                    <div>
                        <strong>@Model.EscalatedIssues.Count escalated issue@(Model.EscalatedIssues.Count != 1 ? "s" : "")</strong>
                        from UmurongoSmart require your final decision.
                        <a href="#" onclick="event.preventDefault();revealAndScroll('section-issues')" style="font-weight:700;margin-left:8px;">View &rarr;</a>
                    </div>
                </div>
            }
            @if (Model.PendingFinalApprovals > 0)
            {
                <div class="dash-alert dash-alert-info">
                    <i class="bi bi-info-circle-fill"></i>
                    <div>
                        <strong>Final Approval Needed:</strong>
                        <strong>@Model.PendingFinalApprovals session @(Model.PendingFinalApprovals == 1 ? "report" : "reports")</strong>
                        approved by HODs &mdash; awaiting your final sign-off.
                        <a href="#" onclick="event.preventDefault();revealAndScroll('section-approvals')" style="font-weight:700;margin-left:8px;">Review &rarr;</a>
                    </div>
                </div>
            }

            <div style="background:linear-gradient(135deg,#0D1E47 0%,#1C3B83 60%,#2952C8 100%);border-radius:16px;padding:32px 36px;margin-bottom:24px;position:relative;overflow:hidden;">
                <div style="position:absolute;top:-50px;right:-50px;width:220px;height:220px;border-radius:50%;background:rgba(255,255,255,0.04);"></div>
                <div style="position:absolute;bottom:-70px;right:60px;width:300px;height:300px;border-radius:50%;background:rgba(255,255,255,0.03);"></div>
                <div style="position:relative;z-index:1;">
                    <div style="display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,0.12);color:#93c5fd;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:5px 14px;border-radius:20px;margin-bottom:14px;">
                        <i class="bi bi-briefcase-fill"></i> Dean of Faculty
                    </div>
                    <h2 style="color:white;font-size:26px;font-weight:800;margin:0 0 4px;">Welcome, @Model.CurrentUser.FullName</h2>
                    <p style="color:rgba(255,255,255,0.6);font-size:13px;margin:0 0 20px;">
                        @Model.TotalDepartments department@(Model.TotalDepartments != 1 ? "s" : "") &nbsp;&middot;&nbsp;
                        @Model.TotalCourses course@(Model.TotalCourses != 1 ? "s" : "") faculty-wide &nbsp;&middot;&nbsp;
                        @(Model.FacultyDeliveryRate)% delivery rate
                        @if (Model.PendingFinalApprovals > 0) { <text>&nbsp;&middot;&nbsp; <span style="color:#fca5a5;">@Model.PendingFinalApprovals pending approval@(Model.PendingFinalApprovals != 1 ? "s" : "")</span></text> }
                    </p>
                    <div style="display:flex;flex-wrap:wrap;gap:10px;">
                        <button type="button" onclick="revealAndScroll('section-approvals')" style="display:inline-flex;align-items:center;gap:7px;padding:9px 18px;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;border:none;background:white;color:#1C3B83;">
                            <i class="bi bi-check2-square"></i> Final Approvals
                            @if (Model.PendingFinalApprovals > 0) { <span style="background:#dc2626;color:white;font-size:10px;font-weight:700;padding:1px 7px;border-radius:20px;">@Model.PendingFinalApprovals</span> }
                        </button>
                        <button type="button" onclick="revealAndScroll('section-depts')" style="display:inline-flex;align-items:center;gap:7px;padding:9px 18px;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;background:rgba(255,255,255,0.12);color:white;border:1px solid rgba(255,255,255,0.25);">
                            <i class="bi bi-diagram-3-fill"></i> Departments
                        </button>
                        @if (Model.EscalatedIssues.Any()) {
                        <button type="button" onclick="revealAndScroll('section-issues')" style="display:inline-flex;align-items:center;gap:7px;padding:9px 18px;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;background:rgba(255,255,255,0.12);color:white;border:1px solid rgba(255,255,255,0.25);">
                            <i class="bi bi-bug-fill"></i> Escalated Issues
                            <span style="background:#dc2626;color:white;font-size:10px;font-weight:700;padding:1px 7px;border-radius:20px;">@Model.EscalatedIssues.Count</span>
                        </button>
                        }
                        <button type="button" onclick="revealAndScroll('section-delivery')" style="display:inline-flex;align-items:center;gap:7px;padding:9px 18px;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;background:rgba(255,255,255,0.12);color:white;border:1px solid rgba(255,255,255,0.25);">
                            <i class="bi bi-bar-chart-fill"></i> Faculty Delivery
                        </button>
                        <button type="button" onclick="revealAndScroll('section-activity')" style="display:inline-flex;align-items:center;gap:7px;padding:9px 18px;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;background:rgba(255,255,255,0.12);color:white;border:1px solid rgba(255,255,255,0.25);">
                            <i class="bi bi-clock-history"></i> Recent Activity
                        </button>
                        <button type="button" onclick="revealAndScroll('section-audit')" style="display:inline-flex;align-items:center;gap:7px;padding:9px 18px;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;background:rgba(255,255,255,0.12);color:white;border:1px solid rgba(255,255,255,0.25);">
                            <i class="bi bi-journal-text"></i> Audit Log
                        </button>
                    </div>
                </div>
            </div>

            <div id="deanContent" style="display:none;">

            @if (Model.EscalatedIssues.Any())
            {
                <div class="dash-card" id="section-issues" style="margin-bottom:22px;">
                    <div class="dash-card-header">
                        <div>
                            <h5><i class="bi bi-bug-fill" style="color:#dc2626;margin-right:8px;"></i>Escalated Platform Issues &mdash; UmurongoSmart</h5>
                            <p>Issues escalated by the HOD requiring your final decision</p>
                        </div>
                        <span class="badge-status badge-missed"><i class="bi bi-exclamation-triangle-fill"></i> @Model.EscalatedIssues.Count escalated</span>
                    </div>
                    <div class="dash-card-body" style="padding:0;">
                        <table class="dash-table">
                            <thead>
                                <tr><th>Issue</th><th>Category</th><th>Priority</th><th>HOD Notes</th><th>Reported</th><th>Action</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var issue in Model.EscalatedIssues)
                                {
                                    var pc = issue.Priority switch {
                                        IssuePriority.Critical => "#dc2626",
                                        IssuePriority.High     => "#d97706",
                                        IssuePriority.Medium   => "#1C3B83",
                                        _                      => "#059669"
                                    };
                                    <tr>
                                        <td>
                                            <strong style="display:block;font-size:13px;">@issue.Title</strong>
                                            <span style="font-size:11px;color:#6b7280;">@(issue.Description.Length > 70 ? issue.Description.Substring(0,70) + "…" : issue.Description)</span>
                                        </td>
                                        <td><span style="background:#eff6ff;color:#1C3B83;padding:3px 8px;border-radius:10px;font-size:10px;font-weight:600;">@issue.Category</span></td>
                                        <td><span style="color:@pc;font-size:12px;font-weight:700;">@issue.Priority</span></td>
                                        <td style="font-size:12px;color:#6b7280;max-width:160px;">@(string.IsNullOrEmpty(issue.HODNotes) ? "—" : issue.HODNotes)</td>
                                        <td style="font-size:11px;color:#9ca3af;">@issue.ReportedOn.ToString("dd MMM")</td>
                                        <td>
                                            @if (issue.Status != IssueStatus.Resolved)
                                            {
                                                <form method="post" asp-page-handler="ResolveIssue" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="issueId" value="@issue.Id" />
                                                    <input type="hidden" name="deanNotes" value="Resolved by Dean." />
                                                    <button type="submit" class="btn-dash-primary btn-dash-sm">
                                                        <i class="bi bi-check-lg"></i> Resolve
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="badge-status badge-approved"><i class="bi bi-check-circle-fill"></i> Resolved</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <div class="dash-stats dash-stats-4">
                <div class="dash-stat-card">
                    <div class="dash-stat-icon icon-blue"><i class="bi bi-diagram-3-fill"></i></div>
                    <div class="dash-stat-body"><strong>@Model.TotalDepartments</strong><span>Departments</span></div>
                </div>
                <div class="dash-stat-card">
                    <div class="dash-stat-icon icon-teal"><i class="bi bi-journal-bookmark-fill"></i></div>
                    <div class="dash-stat-body"><strong>@Model.TotalCourses</strong><span>Courses Faculty-wide</span></div>
                </div>
                <div class="dash-stat-card">
                    <div class="dash-stat-icon icon-amber"><i class="bi bi-check2-square"></i></div>
                    <div class="dash-stat-body"><strong>@Model.PendingFinalApprovals</strong><span>Pending Final Approvals</span></div>
                </div>
                <div class="dash-stat-card">
                    <div class="dash-stat-icon icon-green"><i class="bi bi-graph-up-arrow"></i></div>
                    <div class="dash-stat-body"><strong>@Model.FacultyDeliveryRate%</strong><span>Faculty Delivery Rate</span></div>
                </div>
            </div>

            <div class="dash-grid-2">

                <div class="dash-card" id="section-depts">
                    <div class="dash-card-header">
                        <div>
                            <h5>Department Overview</h5>
                            <p>Delivery performance across all departments</p>
                        </div>
                    </div>
                    <div class="dash-card-body" style="padding:0;">
                        <table class="dash-table">
                            <thead>
                                <tr>
                                    <th>Department</th>
                                    <th>HOD</th>
                                    <th>Courses</th>
                                    <th>Delivery Rate</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dept in Model.DeliveryByDepartment.OrderByDescending(d => d.Value))
                                {
                                    var pct      = (int)dept.Value;
                                    var barColor = pct >= 90 ? "#059669" : pct >= 75 ? "#1C3B83" : pct >= 60 ? "#d97706" : "#dc2626";
                                    var badgeClass = pct >= 90 ? "badge-approved" : pct >= 75 ? "badge-verified" : pct >= 60 ? "badge-pending" : "badge-missed";
                                    var badgeIcon  = pct >= 90 ? "bi-patch-check-fill" : pct >= 75 ? "bi-check-circle-fill" : pct >= 60 ? "bi-clock-history" : "bi-x-circle-fill";
                                    var badgeLabel = pct >= 90 ? "Excellent" : pct >= 75 ? "Good" : pct >= 60 ? "Monitor" : "Critical";
                                    var hod        = Model.HODs.FirstOrDefault(h => h.Department == dept.Key);
                                    var courseCount = Model.AllCourses.Count(c => c.Department == dept.Key);
                                    <tr>
                                        <td><strong style="display:block;font-size:13px;">@dept.Key</strong></td>
                                        <td style="font-size:12px;">@(hod != null ? hod.FullName : "—")</td>
                                        <td>@courseCount</td>
                                        <td>
                                            <div style="display:flex;align-items:center;gap:8px;">
                                                <div style="flex:1;height:5px;background:#f1f5f9;border-radius:5px;overflow:hidden;">
                                                    <div style="width:@pct%;height:100%;background:@barColor;border-radius:5px;"></div>
                                                </div>
                                                <span style="font-size:11px;font-weight:700;">@pct%</span>
                                            </div>
                                        </td>
                                        <td><span class="badge-status @badgeClass"><i class="bi @badgeIcon"></i> @badgeLabel</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                
                <div class="dash-card" id="section-approvals">
                    <div class="dash-card-header">
                        <div>
                            <h5>Pending Final Approvals</h5>
                            <p>HOD-approved sessions awaiting Dean sign-off</p>
                        </div>
                        @if (Model.PendingFinalApprovals > 0)
                        {
                            <span class="badge-status badge-pending">
                                <i class="bi bi-clock-history"></i> @Model.PendingFinalApprovals pending
                            </span>
                        }
                    </div>

                    @if (!Model.AwaitingDeanApproval.Any())
                    {
                        <div class="dash-empty">
                            <i class="bi bi-check2-circle"></i>
                            <p>No sessions awaiting final approval. All up to date.</p>
                        </div>
                    }
                    else
                    {
                        <div class="dash-card-body" style="padding:0;">
                            <table class="dash-table">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Course</th>
                                        <th>Department</th>
                                        <th>HOD</th>
                                        <th>Topic</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in Model.AwaitingDeanApproval)
                                    {
                                        <tr>
                                            <td style="font-size:12px;">@r.SessionDate.ToString("ddd dd MMM")</td>
                                            <td>
                                                <strong style="display:block;font-size:13px;">@r.CourseCode</strong>
                                                <span style="font-size:11px;color:#9ca3af;">@r.CourseTitle</span>
                                            </td>
                                            <td style="font-size:12px;">
                                                @{
                                                    var course = Model.AllCourses.FirstOrDefault(c => c.Code == r.CourseCode);
                                                }
                                                @(course?.Department ?? "—")
                                            </td>
                                            <td style="font-size:12px;">@r.HODNotes?.Split(' ').FirstOrDefault() @r.LecturerName</td>
                                            <td style="font-size:12px;max-width:120px;">
                                                @(string.IsNullOrEmpty(r.TopicCovered) ? "—" : r.TopicCovered)
                                            </td>
                                            <td>
                                                <div style="display:flex;gap:6px;">

                                                    
                                                    <form method="post" asp-page-handler="ApproveSession" style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="reportId" value="@r.Id" />
                                                        <button type="submit" class="btn-dash-primary btn-dash-sm">
                                                            <i class="bi bi-check-lg"></i> Approve
                                                        </button>
                                                    </form>

                                                    
                                                    <button class="btn-dash-outline btn-dash-sm"
                                                            style="color:#dc2626;border-color:#fecaca;"
                                                            onclick="openRejectModal(@r.Id, '@r.CourseCode', '@r.SessionDate.ToString("dd MMM")')">
                                                        <i class="bi bi-x-lg"></i> Reject
                                                    </button>

                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

            </div>

            <div class="dash-card" id="section-delivery">
                    <div class="dash-card-header">
                        <div>
                            <h5>Faculty-Wide Delivery Progress</h5>
                            <p>Overall academic delivery rate per department this semester</p>
                        </div>
                    </div>
                <div class="dash-card-body">
                    @foreach (var dept in Model.DeliveryByDepartment.OrderBy(d => d.Key))
                    {
                        var pct = (int)dept.Value;
                        var barColor = pct >= 90 ? "#059669" : pct >= 75 ? "#1C3B83" : pct >= 60 ? "#d97706" : "#dc2626";
                        <div class="dash-progress-row">
                            <span class="dash-progress-label">@dept.Key</span>
                            <div class="dash-progress-bar-wrap">
                                <div class="dash-progress-bar-fill" style="width:@pct%;background:@barColor;"></div>
                            </div>
                            <span class="dash-progress-pct">@pct%</span>
                        </div>
                    }
                </div>
            </div>

            <div class="dash-card" id="section-activity">
                <div class="dash-card-header">
                    <div>
                        <h5>Recent Approval Activity</h5>
                        <p>Your latest actions across the faculty</p>
                    </div>
                </div>
                <div class="dash-card-body">
                    <div class="dash-timeline">

                        @foreach (var r in Model.SessionReports
                            .Where(r => r.Status >= SessionReportStatus.DeanApproved)
                            .OrderByDescending(r => r.DeanApprovedOn)
                            .Take(5))
                        {
                            <div class="dash-timeline-item">
                                <div class="dash-timeline-dot icon-green">
                                    <i class="bi bi-patch-check-fill" style="color:#059669;font-size:14px;"></i>
                                </div>
                                <div class="dash-timeline-body">
                                    <strong>@r.CourseCode &ndash; @r.CourseTitle approved</strong>
                                    <span>@(r.DeanApprovedOn.HasValue ? r.DeanApprovedOn.Value.ToString("dd MMM, HH:mm") : r.SessionDate.ToString("dd MMM"))</span>
                                </div>
                            </div>
                        }
                        @foreach (var r in Model.SessionReports
                            .Where(r => r.Status == SessionReportStatus.Rejected)
                            .OrderByDescending(r => r.SessionDate)
                            .Take(2))
                        {
                            <div class="dash-timeline-item">
                                <div class="dash-timeline-dot icon-red">
                                    <i class="bi bi-x-circle-fill" style="color:#dc2626;font-size:14px;"></i>
                                </div>
                                <div class="dash-timeline-body">
                                    <strong>@r.CourseCode report returned for revision</strong>
                                    <span>@r.SessionDate.ToString("dd MMM, HH:mm")</span>
                                </div>
                            </div>
                        }
                        @if (!Model.SessionReports.Any(r => r.Status >= SessionReportStatus.DeanApproved || r.Status == SessionReportStatus.Rejected))
                        {
                            <div class="dash-empty"><i class="bi bi-clock-history"></i><p>No activity yet this semester.</p></div>
                        }

                    </div>
                </div>
            </div>

            </div><!-- /#deanContent -->

            <div class="dash-card" id="section-audit" style="display:none;">
                <div class="dash-card-header">
                    <div>
                        <h5><i class="bi bi-journal-text" style="color:#1C3B83;margin-right:8px;"></i>Faculty Audit Log</h5>
                        <p>Complete record of all approvals, rejections, escalations and delivery flags this semester</p>
                    </div>
                    <span class="badge-status badge-active" style="font-size:11px;">
                        <i class="bi bi-shield-check"></i> Dean Only
                    </span>
                </div>
                <div class="dash-card-body" style="padding:0;">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th style="width:140px;">Date &amp; Time</th>
                                <th style="width:100px;">Type</th>
                                <th>Description</th>
                                <th style="width:130px;">Actor / Subject</th>
                                <th style="width:90px;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var auditRows = new List<(DateTime When, string Type, string TypeColor, string TypeBg, string Icon, string Desc, string Actor, string StatusClass, string StatusLabel)>();

                                foreach (var r in Model.SessionReports.Where(x => x.Status == SessionReportStatus.DeanApproved && x.DeanApprovedOn.HasValue).OrderByDescending(x => x.DeanApprovedOn))
                                {
                                    auditRows.Add((r.DeanApprovedOn!.Value, "Approved", "#059669", "#ecfdf5", "patch-check-fill",
                                        $"Session report for {r.CourseCode} – {r.CourseTitle} given final Dean approval",
                                        r.LecturerName, "badge-approved", "Final Approved"));
                                }
                                foreach (var r in Model.SessionReports.Where(x => x.Status == SessionReportStatus.Rejected && x.SessionDate != default).OrderByDescending(x => x.SessionDate))
                                {
                                    auditRows.Add((r.SessionDate, "Rejected", "#dc2626", "#fef2f2", "x-circle-fill",
                                        $"Session report for {r.CourseCode} returned for revision" + (string.IsNullOrEmpty(r.RejectionReason) ? "" : $": {r.RejectionReason}"),
                                        r.LecturerName, "badge-missed", "Returned"));
                                }
                                foreach (var r in Model.SessionReports.Where(x => x.Status >= SessionReportStatus.HODApproved && x.HODApprovedOn.HasValue).OrderByDescending(x => x.HODApprovedOn))
                                {
                                    auditRows.Add((r.HODApprovedOn!.Value, "HOD Sign-off", "#1C3B83", "#eff6ff", "check2-square",
                                        $"{r.CourseCode} – {r.CourseTitle} approved by HOD, forwarded to Dean",
                                        r.ClassRepresentativeName, "badge-verified", "HOD Approved"));
                                }
                                foreach (var issue in Model.EscalatedIssues.OrderByDescending(i => i.ReportedOn))
                                {
                                    var statusLabel = issue.Status == IssueStatus.Resolved ? "Resolved" : "Escalated";
                                    var statusClass = issue.Status == IssueStatus.Resolved ? "badge-approved" : "badge-missed";
                                    auditRows.Add((issue.ReportedOn, "Escalation", "#dc2626", "#fef2f2", "bug-fill",
                                        $"UmurongoSmart issue escalated to Dean: {issue.Title}",
                                        issue.ReportedBy, statusClass, statusLabel));
                                }
                                foreach (var c in Model.AllCourses.Where(x => x.ScheduledHours > 0 && (double)x.DeliveredHours / x.ScheduledHours * 100 < 70).OrderBy(x => x.DeliveredHours))
                                {
                                    var pct = (int)Math.Round((double)c.DeliveredHours / c.ScheduledHours * 100);
                                    auditRows.Add((DateTime.Now, "Flag", "#d97706", "#fffbeb", "exclamation-triangle-fill",
                                        $"{c.Code} – {c.Title} below 70% delivery threshold ({pct}%)",
                                        c.Lecturer, "badge-pending", "Flagged"));
                                }

                                auditRows = auditRows.OrderByDescending(x => x.When).ToList();
                            }

                            @if (!auditRows.Any())
                            {
                                <tr>
                                    <td colspan="5" style="text-align:center;padding:32px;color:#9ca3af;">
                                        <i class="bi bi-journal-text" style="font-size:28px;display:block;margin-bottom:8px;"></i>
                                        No audit entries yet this semester.
                                    </td>
                                </tr>
                            }
                            @foreach (var row in auditRows)
                            {
                                <tr>
                                    <td style="font-size:11px;color:#6b7280;white-space:nowrap;">
                                        <strong style="display:block;color:#374151;">@row.When.ToString("dd MMM yyyy")</strong>
                                        @row.When.ToString("HH:mm")
                                    </td>
                                    <td>
                                        <span style="display:inline-flex;align-items:center;gap:5px;background:@row.TypeBg;color:@row.TypeColor;font-size:10px;font-weight:700;padding:3px 9px;border-radius:20px;white-space:nowrap;">
                                            <i class="bi bi-@row.Icon" style="font-size:10px;"></i>
                                            @row.Type
                                        </span>
                                    </td>
                                    <td style="font-size:12px;color:#374151;">@row.Desc</td>
                                    <td style="font-size:11px;color:#6b7280;max-width:130px;">@row.Actor</td>
                                    <td>
                                        <span class="badge-status @row.StatusClass" style="font-size:10px;">@row.StatusLabel</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

    </div>

</div>

<div id="deanRejectModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);
     z-index:3000;align-items:center;justify-content:center;">
    <div style="background:white;border-radius:14px;padding:28px;width:100%;max-width:440px;
                margin:20px;box-shadow:0 20px 50px rgba(0,0,0,.2);">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <h5 style="margin:0;font-size:16px;font-weight:700;color:#0D1E47;">
                <i class="bi bi-x-circle-fill" style="color:#dc2626;margin-right:8px;"></i>
                Return to HOD
            </h5>
            <button onclick="closeDeanReject()" style="background:none;border:none;font-size:18px;
                    color:#9ca3af;cursor:pointer;"><i class="bi bi-x-lg"></i></button>
        </div>
        <p id="deanRejectDesc" style="font-size:13px;color:#6b7280;margin-bottom:14px;"></p>
        <form method="post" asp-page-handler="RejectSession">
            @Html.AntiForgeryToken()
            <input type="hidden" name="reportId" id="deanRejectId" />
            <div style="margin-bottom:16px;">
                <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:5px;">
                    Reason for returning <span style="color:#dc2626;">*</span>
                </label>
                <textarea name="reason" id="deanRejectReason" rows="3" required
                          style="width:100%;padding:9px 12px;border:1px solid #d1d5db;
                                 border-radius:7px;font-size:13px;outline:none;resize:vertical;"
                          placeholder="Explain what needs to be corrected..."></textarea>
            </div>
            <div style="display:flex;gap:10px;justify-content:flex-end;">
                <button type="button" onclick="closeDeanReject()" class="btn-dash-outline">Cancel</button>
                <button type="submit" class="btn-dash-primary" style="background:#dc2626;">
                    <i class="bi bi-x-lg"></i> Return to HOD
                </button>
            </div>
        </form>
    </div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function revealAndScroll(sectionId) {
        var c = document.getElementById('deanContent');
        if (c) c.style.display = 'block';
        var audit = document.getElementById('section-audit');
        if (audit) audit.style.display = 'block';
        setTimeout(function() {
            var el = document.getElementById(sectionId);
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 50);
    }
    function openRejectModal(reportId, courseCode, date) {
        document.getElementById('deanRejectId').value = reportId;
        document.getElementById('deanRejectDesc').textContent =
            'Returning session report for ' + courseCode + ' on ' + date + ' to the HOD for revision.';
        document.getElementById('deanRejectReason').value = '';
        document.getElementById('deanRejectModal').style.display = 'flex';
    }
    function closeDeanReject() {
        document.getElementById('deanRejectModal').style.display = 'none';
    }
    document.addEventListener('DOMContentLoaded', function() {
        var m = document.getElementById('deanRejectModal');
        if (m) m.addEventListener('click', function(e) { if (e.target === m) closeDeanReject(); });
    });
</script>
</body>
</html>

