@page
@model CourseScheduleSystem.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Login | CSAS – UNILAK";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html, body {
            height: 100%;
            font-family: 'Inter', 'Segoe UI', sans-serif;
            overflow: hidden;
        }

        
        .bg-wrap {
            position: fixed;
            inset: 0;
            z-index: 0;
        }
        .bg-slide {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            background-color: #1e1b4b;
            opacity: 0;
            transition: opacity 1.5s ease-in-out;
        }
        .bg-slide.active { opacity: 1; }

        
        .bg-tint {
            position: fixed;
            inset: 0;
            z-index: 1;
            background: rgba(15, 12, 50, 0.60);
            backdrop-filter: blur(3px);
        }

        
        .shell {
            position: relative;
            z-index: 2;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
        }

        
        
        .card-wrap {
            display: flex;
            width: 100%;
            max-width: 820px;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 24px 64px rgba(0, 0, 0, 0.55),
                        0 0 0 1px rgba(255,255,255,0.08);
        }

        
        .panel-left {
            flex: 1.05;
            background: linear-gradient(155deg, #3730a3 0%, #4c3fa0 50%, #2e2a80 100%);
            padding: 36px 30px 30px;
            color: white;
            display: flex;
            flex-direction: column;
        }

        .pl-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 26px;
        }

        .pl-logo-icon {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: rgba(255,255,255,0.15);
            border: 1px solid rgba(255,255,255,0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .pl-logo-text strong {
            display: block;
            font-size: 13px;
            font-weight: 800;
        }

        .pl-logo-text span {
            font-size: 10px;
            color: rgba(255,255,255,0.5);
        }

        .panel-left h2 {
            font-size: 19px;
            font-weight: 800;
            line-height: 1.25;
            margin-bottom: 5px;
        }

        .panel-left .tagline {
            font-size: 12px;
            color: rgba(255,255,255,0.6);
            margin-bottom: 22px;
        }

        
        .pl-box {
            background: rgba(255,255,255,0.10);
            border: 1px solid rgba(255,255,255,0.14);
            border-radius: 10px;
            padding: 14px 16px;
            margin-bottom: 12px;
        }

        .pl-box-head {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 5px;
        }

        .pl-box-head i { font-size: 14px; color: #fbbf24; }
        .pl-box-head strong { font-size: 13px; font-weight: 700; }

        .pl-box p {
            font-size: 11.5px;
            color: rgba(255,255,255,0.6);
            line-height: 1.55;
            margin: 0;
        }

        
        .pl-roles {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-top: 4px;
        }

        .pl-roles li {
            font-size: 11.5px;
            color: rgba(255,255,255,0.75);
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .pl-roles li i { color: #34d399; font-size: 12px; flex-shrink: 0; }

        
        .pl-dots {
            margin-top: auto;
            padding-top: 20px;
            display: flex;
            gap: 6px;
        }

        .pl-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: rgba(255,255,255,0.3);
            border: none;
            cursor: pointer;
            padding: 0;
            transition: .3s ease;
        }

        .pl-dot.active {
            background: white;
            width: 18px;
            border-radius: 3px;
        }

        
        .panel-right {
            width: 350px;
            flex-shrink: 0;
            background: #ffffff;
            padding: 36px 30px 28px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        
        .pr-logo {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            background: linear-gradient(135deg, #4338ca, #7c3aed);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: white;
            margin-bottom: 12px;
            box-shadow: 0 4px 14px rgba(67,56,202,0.35);
        }

        .panel-right h1 {
            font-size: 18px;
            font-weight: 800;
            color: #1e1b4b;
            margin-bottom: 22px;
            text-align: center;
        }

        
        .pr-form { width: 100%; }

        .pr-field { margin-bottom: 14px; }

        .pr-field label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #374151;
            margin-bottom: 5px;
        }

        .pr-input-wrap { position: relative; }

        .pr-input-wrap .fi {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 13px;
            color: #9ca3af;
            pointer-events: none;
        }

        .pr-input-wrap input,
        .pr-input-wrap select {
            width: 100%;
            padding: 10px 12px 10px 34px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 13px;
            color: #111827;
            outline: none;
            transition: border .15s ease, box-shadow .15s ease;
            background: white;
        }

        .pr-input-wrap input:focus,
        .pr-input-wrap select:focus {
            border-color: #4338ca;
            box-shadow: 0 0 0 3px rgba(67,56,202,0.10);
        }

        .pr-input-wrap input::placeholder { color: #bbb; font-size: 12px; }

        .pr-eye {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: #9ca3af;
            font-size: 14px;
            padding: 0;
        }

        .pr-eye:hover { color: #4338ca; }

        
        .pr-opts {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .pr-remember {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: #6b7280;
            cursor: pointer;
        }

        .pr-remember input { accent-color: #4338ca; width: 13px; height: 13px; }

        .pr-forgot {
            font-size: 12px;
            color: #4338ca;
            text-decoration: none;
            font-weight: 600;
        }

        .pr-forgot:hover { text-decoration: underline; }

        
        .btn-login {
            width: 100%;
            padding: 11px;
            background: linear-gradient(90deg, #4338ca 0%, #7c3aed 100%);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            letter-spacing: 0.5px;
            transition: .2s ease;
            box-shadow: 0 4px 14px rgba(67,56,202,0.4);
            margin-bottom: 14px;
        }

        .btn-login:hover {
            background: linear-gradient(90deg, #3730a3 0%, #6d28d9 100%);
            transform: translateY(-1px);
        }

        
        .pr-error {
            width: 100%;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #dc2626;
            border-radius: 7px;
            padding: 9px 12px;
            font-size: 12px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 7px;
        }

        
        .pr-register {
            font-size: 11.5px;
            color: #6b7280;
            text-align: center;
        }

        .pr-register a {
            color: #4338ca;
            font-weight: 700;
            text-decoration: none;
        }

        .pr-register a:hover { text-decoration: underline; }

        
        @@media (max-width: 780px) {
            .panel-left { display: none; }
            .panel-right { width: 100%; max-width: 400px; }
            body { overflow: auto; }
            .shell { min-height: 100vh; }
        }
    </style>
</head>
<body>

    
    <div class="bg-wrap">
        <div class="bg-slide active"
             style="background-image:url('/images/dean1.jpeg');"></div>
        <div class="bg-slide"
             style="background-image:url('/images/zpc1.jpeg');"></div>
        <div class="bg-slide"
             style="background-image:url('/images/Rulinda1.jpeg');"></div>
    </div>
    <div class="bg-tint"></div>

    
    <div class="shell">
        <div class="card-wrap">

            
            <div class="panel-left">

                <div class="pl-logo">
                    <div class="pl-logo-icon" style="background:none;padding:0;"><img src="/images/logo.jpeg" alt="UNILAK" style="width:36px;height:36px;border-radius:50%;object-fit:cover;" /></div>
                    <div class="pl-logo-text">
                        <strong>CSAS</strong>
                        <span>CSAS Portal</span>
                    </div>
                </div>

                <h2>Welcome to UNILAK</h2>
                <p class="tagline">Your gateway to quality education and academic excellence.</p>

                
                <div class="pl-box">
                    <div class="pl-box-head">
                        <i class="bi bi-calendar3-week"></i>
                        <strong>Course Schedule &amp; Awareness</strong>
                    </div>
                    <p>
                        Timetables, session verification, marks and verified
                        class communication — all in one secure platform.
                    </p>
                </div>

                
                <div class="pl-box">
                    <div class="pl-box-head">
                        <i class="bi bi-people-fill"></i>
                        <strong>Access Levels</strong>
                    </div>
                    <ul class="pl-roles">
                        <li><i class="bi bi-check-circle-fill"></i>Students</li>
                        <li><i class="bi bi-check-circle-fill"></i>Class Representatives</li>
                        <li><i class="bi bi-check-circle-fill"></i>Lecturers</li>
                        <li><i class="bi bi-check-circle-fill"></i>Head of Department</li>
                        <li><i class="bi bi-check-circle-fill"></i>Dean</li>
                        <li><i class="bi bi-check-circle-fill"></i>Director of Quality</li>
                    </ul>
                </div>

                
                <div class="pl-dots" id="dots">
                    <button class="pl-dot active" onclick="goTo(0)"></button>
                    <button class="pl-dot" onclick="goTo(1)"></button>
                    <button class="pl-dot" onclick="goTo(2)"></button>
                </div>

            </div>

            
            <div class="panel-right">

                <div class="pr-logo" style="background:none;box-shadow:none;width:72px;height:72px;"><img src="/images/logo.jpeg" alt="UNILAK" style="width:72px;height:72px;border-radius:50%;object-fit:cover;box-shadow:0 4px 14px rgba(0,0,0,0.2);" /></div>

                <h1>Login to Account</h1>

                
                @if (Model.ErrorMessage != null)
                {
                    <div class="pr-error">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        @Model.ErrorMessage
                    </div>
                }

                <form method="post" class="pr-form">
                    @Html.AntiForgeryToken()

                    
                    <div class="pr-field">
                        <label>Username</label>
                        <div class="pr-input-wrap">
                            <i class="bi bi-person-fill fi"></i>
                            <input type="text"
                                   asp-for="Identifier"
                                   placeholder="Enter your username"
                                   required />
                        </div>
                    </div>

                    
                    <div class="pr-field">
                        <label>Password</label>
                        <div class="pr-input-wrap">
                            <i class="bi bi-lock-fill fi"></i>
                            <input type="password"
                                   asp-for="Password"
                                   id="pwdField"
                                   placeholder="Enter your password"
                                   required />
                            <button type="button" class="pr-eye" onclick="togglePwd()">
                                <i class="bi bi-eye-fill" id="pwdIco"></i>
                            </button>
                        </div>
                    </div>

                    
                    <div class="pr-field">
                        <label>Login As</label>
                        <div class="pr-input-wrap">
                            <i class="bi bi-person-badge-fill fi"></i>
                            <select asp-for="Role">
                                <option value="student">Student</option>
                                <option value="cp">Class Representative</option>
                                <option value="lecturer">Lecturer</option>
                                <option value="hod">Head of Department</option>
                                <option value="dean">Dean</option>
                                <option value="quality">Director of Quality</option>
                            </select>
                        </div>
                    </div>

                    
                    <div class="pr-opts">
                        <label class="pr-remember">
                            <input type="checkbox" /> Remember me
                        </label>
                        <a href="#" class="pr-forgot">Forgot Password?</a>
                    </div>

                    <button type="submit" class="btn-login">Login</button>

                </form>

                <p class="pr-register">
                    New to CSAS? <a href="/Register">Create an account</a>
                </p>

            </div>

        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        
        var slides = document.querySelectorAll('.bg-slide');
        var dots   = document.querySelectorAll('.pl-dot');
        var cur    = 0, t = null;

        function goTo(i) {
            slides[cur].classList.remove('active');
            dots[cur].classList.remove('active');
            cur = i;
            slides[cur].classList.add('active');
            dots[cur].classList.add('active');
        }

        function tick() { goTo((cur + 1) % slides.length); }
        function start() { t = setInterval(tick, 5000); }

        dots.forEach(function(d, i) {
            d.addEventListener('click', function() {
                clearInterval(t);
                goTo(i);
                setTimeout(start, 8000);
            });
        });

        start();

        
        function togglePwd() {
            var f = document.getElementById('pwdField');
            var i = document.getElementById('pwdIco');
            if (f.type === 'password') {
                f.type = 'text';
                i.className = 'bi bi-eye-slash-fill';
            } else {
                f.type = 'password';
                i.className = 'bi bi-eye-fill';
            }
        }
    </script>

</body>
</html>
