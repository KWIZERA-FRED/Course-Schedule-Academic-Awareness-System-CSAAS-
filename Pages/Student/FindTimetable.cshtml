@page
@model CourseScheduleSystem.Web.Pages.Student.FindTimetableModel
@{
    ViewData["Title"] = "Find My Timetable";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Find My Timetable | CSAS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>
<div class="dash-shell">

    <aside class="dash-sidebar">
        <a href="/" class="dash-sidebar-brand">
            <div class="dash-sidebar-brand-icon" style="background:transparent;box-shadow:none;padding:2px;">
                <img src="/images/logo.jpeg" alt="UNILAK" style="width:34px;height:34px;border-radius:50%;object-fit:cover;" />
            </div>
            <div class="dash-sidebar-brand-text"><strong>CSAS</strong><span>Student Portal</span></div>
        </a>
        <div class="dash-sidebar-section">Main Menu</div>
        <nav class="dash-sidebar-nav">
            <a href="/" class="dash-nav-link"><i class="bi bi-house-fill"></i> Home</a>
            <a href="/Student/Dashboard" class="dash-nav-link"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a href="/Student/Courses" class="dash-nav-link"><i class="bi bi-journal-bookmark-fill"></i> My Courses</a>
            <a href="/Student/FindTimetable" class="dash-nav-link active"><i class="bi bi-calendar-week-fill"></i> Find Timetable</a>
            <a href="/Timetable/Report" class="dash-nav-link"><i class="bi bi-calendar3-week"></i> Class Timetable</a>
            <a href="/Timetable/Exams" class="dash-nav-link"><i class="bi bi-journal-check"></i> Exam Timetable</a>
            <a href="/Student/Schedule" class="dash-nav-link"><i class="bi bi-calendar3-week"></i> My Schedule</a>
            <a href="/Student/Groups" class="dash-nav-link"><i class="bi bi-whatsapp"></i> Class Groups</a>
            <a href="/Student/Notifications" class="dash-nav-link">
                <i class="bi bi-bell"></i> Notifications
                @if (Model.UnreadNotifications > 0)
                {
                    <span style="margin-left:auto;background:#dc2626;color:white;font-size:10px;font-weight:700;padding:1px 7px;border-radius:20px;">@Model.UnreadNotifications</span>
                }
            </a>
            <a href="https://umurongosmart.com/" target="_blank" class="dash-nav-link"
               style="border-top:1px solid rgba(255,255,255,0.07);margin-top:4px;padding-top:12px;">
                <iconify-icon icon="mdi:headset-mic" style="font-size:16px;vertical-align:middle;"></iconify-icon> UmurongoSmart Support
            </a>
        </nav>
        <div class="dash-sidebar-section">Account</div>
        <nav class="dash-sidebar-nav">
            <a href="/Profile" class="dash-nav-link"><i class="bi bi-person"></i> My Profile</a>
            <a href="/Logout" class="dash-nav-link"><i class="bi bi-box-arrow-left"></i> Logout</a>
        </nav>
        <div class="dash-sidebar-footer">
            <div class="dash-sidebar-user">
                <div class="dash-user-avatar"><i class="bi bi-person-fill"></i></div>
                <div class="dash-user-info">
                    <strong>@Model.CurrentUser.FullName</strong>
                    <span>Student</span>
                </div>
            </div>
        </div>
    </aside>

    <div class="dash-main">
        <div class="dash-topbar">
            <div class="dash-topbar-title">
                <h1>Find My Timetable</h1>
                <p>Search academic timetables by department, year of study and semester</p>
            </div>
            <div class="dash-topbar-actions">
                <a href="/Student/Dashboard" class="dash-icon-btn" title="Notifications">
                    <i class="bi bi-bell"></i>
                </a>
            </div>
        </div>

        <div class="dash-content">

            <div style="background:linear-gradient(135deg,#0D1E47 0%,#1C3B83 60%,#2952C8 100%);border-radius:16px;padding:32px 36px;margin-bottom:24px;position:relative;overflow:hidden;">
                <div style="position:absolute;top:-50px;right:-50px;width:200px;height:200px;border-radius:50%;background:rgba(255,255,255,0.04);"></div>
                <div style="position:absolute;bottom:-60px;right:80px;width:280px;height:280px;border-radius:50%;background:rgba(255,255,255,0.03);"></div>
                <div style="position:relative;z-index:1;">
                    <div style="display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,0.12);color:#93c5fd;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:5px 14px;border-radius:20px;margin-bottom:14px;">
                        <i class="bi bi-search"></i> Timetable Finder
                    </div>
                    <h2 style="color:white;font-size:24px;font-weight:800;margin:0 0 4px;">Find your class timetable, anytime, anywhere</h2>
                    <p style="color:rgba(255,255,255,0.6);font-size:13px;margin:0 0 22px;">Select your department, year of study and semester to find your published timetable</p>

                    <form method="get" asp-page="/Student/FindTimetable" style="display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;">
                        <div style="flex:1;min-width:200px;">
                            <label style="display:block;font-size:11px;font-weight:700;color:rgba(255,255,255,0.7);margin-bottom:5px;text-transform:uppercase;letter-spacing:.06em;">Department</label>
                            <select name="dept" style="width:100%;padding:11px 12px;border:none;border-radius:10px;font-size:13px;outline:none;background:rgba(255,255,255,0.97);color:#0D1E47;">
                                <option value="">All Departments</option>
                                @foreach (var d in Model.Departments)
                                {
                                    if (d == Model.SelectedDept)
                                    {
                                        <option value="@d" selected>@d</option>
                                    }
                                    else
                                    {
                                        <option value="@d">@d</option>
                                    }
                                }
                            </select>
                        </div>
                        <div style="min-width:130px;">
                            <label style="display:block;font-size:11px;font-weight:700;color:rgba(255,255,255,0.7);margin-bottom:5px;text-transform:uppercase;letter-spacing:.06em;">Year of Study</label>
                            <select name="year" style="width:100%;padding:11px 12px;border:none;border-radius:10px;font-size:13px;outline:none;background:rgba(255,255,255,0.97);color:#0D1E47;">
                                <option value="0">All Years</option>
                                <option value="1">Year 1</option>
                                <option value="2">Year 2</option>
                                <option value="3">Year 3</option>
                                <option value="4">Year 4</option>
                            </select>
                        </div>
                        <div style="min-width:130px;">
                            <label style="display:block;font-size:11px;font-weight:700;color:rgba(255,255,255,0.7);margin-bottom:5px;text-transform:uppercase;letter-spacing:.06em;">Semester</label>
                            <select name="semester" style="width:100%;padding:11px 12px;border:none;border-radius:10px;font-size:13px;outline:none;background:rgba(255,255,255,0.97);color:#0D1E47;">
                                <option value="0">All Semesters</option>
                                <option value="1">Semester 1</option>
                                <option value="2">Semester 2</option>
                                <option value="3">Semester 3</option>
                            </select>
                        </div>
                        <div style="min-width:140px;">
                            <label style="display:block;font-size:11px;font-weight:700;color:rgba(255,255,255,0.7);margin-bottom:5px;text-transform:uppercase;letter-spacing:.06em;">Academic Year</label>
                            <select name="academicYear" style="width:100%;padding:11px 12px;border:none;border-radius:10px;font-size:13px;outline:none;background:rgba(255,255,255,0.97);color:#0D1E47;">
                                <option value="">All Years</option>
                                @foreach (var y in Model.AcademicYears)
                                {
                                    <option value="@y">@y</option>
                                }
                            </select>
                        </div>
                        <button type="submit" style="display:inline-flex;align-items:center;gap:7px;padding:11px 22px;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;border:none;background:white;color:#1C3B83;white-space:nowrap;">
                            <i class="bi bi-search"></i> Find Timetable
                        </button>
                    </form>
                </div>
            </div>

            @if (Model.Results.Any())
            {
                <div class="dash-alert dash-alert-success" style="margin-bottom:20px;">
                    <i class="bi bi-check-circle-fill"></i>
                    <div>
                        <strong>@Model.Results.Count timetable@(Model.Results.Count != 1 ? "s" : "") found</strong>
                        for your search. Click <strong>Download</strong> to save the file to your device.
                    </div>
                </div>

                <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:16px;">
                    @foreach (var t in Model.Results)
                    {
                        <div style="background:white;border:1px solid #e5e7eb;border-radius:14px;padding:22px;box-shadow:0 2px 8px rgba(0,0,0,0.04);transition:.2s;"
                             onmouseover="this.style.boxShadow='0 8px 24px rgba(28,59,131,0.1)';this.style.borderColor='#bfdbfe';"
                             onmouseout="this.style.boxShadow='0 2px 8px rgba(0,0,0,0.04)';this.style.borderColor='#e5e7eb';">

                            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:14px;">
                                <div style="width:44px;height:44px;border-radius:10px;background:#eff6ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                    <i class="bi bi-file-earmark-spreadsheet-fill" style="font-size:20px;color:#1C3B83;"></i>
                                </div>
                                <span style="background:#ecfdf5;color:#059669;font-size:10px;font-weight:700;padding:3px 10px;border-radius:20px;">
                                    <i class="bi bi-check-circle-fill"></i> Published
                                </span>
                            </div>

                            <div style="margin-bottom:12px;">
                                <div style="font-size:15px;font-weight:800;color:#0D1E47;margin-bottom:3px;">@t.Department</div>
                                <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:6px;">
                                    <span style="background:#eff6ff;color:#1C3B83;font-size:11px;font-weight:700;padding:2px 9px;border-radius:6px;">
                                        Year @t.YearOfStudy
                                    </span>
                                    <span style="background:#f5f3ff;color:#7c3aed;font-size:11px;font-weight:700;padding:2px 9px;border-radius:6px;">
                                        Semester @t.Semester
                                    </span>
                                    <span style="background:#f3f4f6;color:#374151;font-size:11px;font-weight:700;padding:2px 9px;border-radius:6px;">
                                        @t.AcademicYear
                                    </span>
                                </div>
                            </div>

                            <div style="font-size:12px;color:#6b7280;margin-bottom:4px;">
                                <i class="bi bi-file-earmark" style="margin-right:4px;"></i>@t.FileName
                            </div>
                            <div style="font-size:11px;color:#9ca3af;margin-bottom:16px;">
                                <i class="bi bi-person-fill" style="margin-right:4px;"></i>Uploaded by @t.UploadedBy
                                &nbsp;&middot;&nbsp;
                                @(t.PublishedOn.HasValue ? t.PublishedOn.Value.ToString("dd MMM yyyy") : t.UploadedOn.ToString("dd MMM yyyy"))
                            </div>

                            @if (!string.IsNullOrEmpty(t.Notes))
                            {
                                <div style="background:#f8fafc;border-radius:8px;padding:8px 10px;font-size:11px;color:#6b7280;margin-bottom:14px;">
                                    <i class="bi bi-info-circle-fill" style="color:#1C3B83;margin-right:5px;"></i>@t.Notes
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(t.StoredPath))
                            {
                                <a href="@t.StoredPath" download="@t.FileName"
                                   style="display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:11px;background:#1C3B83;color:white;border-radius:10px;text-decoration:none;font-size:13px;font-weight:700;transition:.15s;"
                                   onmouseover="this.style.background='#0D1E47';" onmouseout="this.style.background='#1C3B83';">
                                    <i class="bi bi-download"></i> Download Timetable
                                </a>
                            }
                            else
                            {
                                <div style="display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:11px;background:#f3f4f6;color:#9ca3af;border-radius:10px;font-size:13px;font-weight:700;">
                                    <i class="bi bi-exclamation-circle"></i> File not available
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (Model.HasSearched || !string.IsNullOrEmpty(Model.SelectedDept))
            {
                <div class="dash-empty" style="padding:60px;text-align:center;">
                    <i class="bi bi-calendar-x" style="font-size:48px;color:#d1d5db;display:block;margin-bottom:14px;"></i>
                    <h4 style="color:#6b7280;font-weight:600;">No Timetable Found</h4>
                    <p style="color:#9ca3af;font-size:14px;max-width:420px;margin:8px auto 0;">
                        No published timetable matches your selection.
                        Try changing the filters or check back later — your HOD may not have published it yet.
                    </p>
                    <a href="/Student/FindTimetable" class="btn-dash-outline btn-dash-sm" style="margin-top:18px;">
                        <i class="bi bi-arrow-clockwise"></i> Reset Search
                    </a>
                </div>
            }
            else
            {
                <div style="text-align:center;padding:48px 20px;color:#9ca3af;">
                    <i class="bi bi-search" style="font-size:44px;display:block;margin-bottom:12px;color:#d1d5db;"></i>
                    <p style="font-size:14px;">Use the search form above to find your timetable.</p>
                </div>
            }

        </div>
    </div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
