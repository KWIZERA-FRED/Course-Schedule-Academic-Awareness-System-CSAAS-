@page
@model CourseScheduleSystem.Web.Pages.Student.DashboardModel
@{
    ViewData["Title"] = "Student Dashboard";
    Layout = null;
    var expiredCourses = Model.Courses.Where(c => c.JoinDeadline < DateTime.Now).ToList();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Dashboard | CSAS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
</head>
<body>

<div class="dash-shell">

    <aside class="dash-sidebar">

        <a href="/" class="dash-sidebar-brand">
            <div class="dash-sidebar-brand-icon" style="background:transparent;box-shadow:none;padding:2px;">
                <img src="/images/logo.jpeg" alt="UNILAK" style="width:34px;height:34px;border-radius:50%;object-fit:cover;" />
            </div>
            <div class="dash-sidebar-brand-text">
                <strong>CSAS</strong>
                <span>Student</span>
            </div>
        </a>

        <div class="dash-sidebar-section">Main Menu</div>

        <nav class="dash-sidebar-nav">
            <a href="/" class="dash-nav-link">
                <i class="bi bi-house-fill"></i> Home
            </a>
            <a href="/Student/Dashboard" class="dash-nav-link active">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a href="/Student/Courses" class="dash-nav-link">
                <i class="bi bi-journal-bookmark-fill"></i> My Courses
            </a>
            <a href="#section-marks" class="dash-nav-link"
               onclick="revealAndScroll('section-marks')">
                <i class="bi bi-bar-chart-line-fill"></i> My Marks
            </a>
            <a href="#section-claims" class="dash-nav-link"
               onclick="revealAndScroll('section-claims')">
                <i class="bi bi-chat-left-text-fill"></i> My Claims
            </a>
            <a href="/Student/Schedule" class="dash-nav-link">
                <i class="bi bi-calendar3-week"></i> My Schedule
            </a>
            <a href="/Student/Groups" class="dash-nav-link">
                <i class="bi bi-whatsapp"></i> Class Groups
            </a>
            <a href="/Student/Notifications" class="dash-nav-link">
                <i class="bi bi-bell"></i> Notifications
                @if (Model.UnreadNotifications > 0)
                {
                    <span style="margin-left:auto;background:#dc2626;color:white;font-size:10px;font-weight:700;padding:1px 7px;border-radius:20px;">@Model.UnreadNotifications</span>
                }
            </a>
            <a href="https://umurongosmart.com/" target="_blank" class="dash-nav-link"
               title="UmurongoSmart Support"
               style="border-top:1px solid rgba(255,255,255,0.07);margin-top:4px;padding-top:12px;">
                <iconify-icon icon="mdi:headset-mic" style="font-size:16px;vertical-align:middle;"></iconify-icon> UmurongoSmart Support
            </a>
        </nav>

        <div class="dash-sidebar-section">Account</div>

        <nav class="dash-sidebar-nav">
            <a href="/Profile" class="dash-nav-link">
                <i class="bi bi-person"></i> My Profile
            </a>
            <a href="/Logout" class="dash-nav-link">
                <i class="bi bi-box-arrow-left"></i> Logout
            </a>
        </nav>

        <div class="dash-sidebar-footer">
            <div class="dash-sidebar-user">
                <div class="dash-user-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div class="dash-user-info">
                    <strong>@Model.CurrentUser.FullName</strong>
                    <span>Student</span>
                </div>
            </div>
        </div>

    </aside>

    <div class="dash-main">

        <div class="dash-topbar">
            <div class="dash-topbar-title">
                <h1>Student Dashboard</h1>
                <p>Welcome back, @Model.CurrentUser.FirstName &mdash; here is your academic overview</p>
            </div>
            <div class="dash-topbar-actions">
                <a href="/Student/Notifications" class="dash-icon-btn" title="Notifications">
                    <i class="bi bi-bell"></i>
                </a>
                <div class="dash-topbar-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>
            </div>
        </div>

        <div class="dash-content">

            @if (Model.StatusMessage != null)
            {
                var alertClass = Model.StatusType == "success" ? "dash-alert-success"
                               : Model.StatusType == "warning" ? "dash-alert-warning"
                               : "dash-alert-info";
                <div class="dash-alert @alertClass">
                    <i class="bi bi-@(Model.StatusType == "success" ? "check-circle-fill" : "exclamation-triangle-fill")"></i>
                    <div>@Model.StatusMessage</div>
                </div>
            }

            @if (expiredCourses.Any())
            {
                <div class="dash-alert dash-alert-warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>
                        <strong>Deadline Reminder:</strong>
                        @if (expiredCourses.Count == 1)
                        {
                            <text>The WhatsApp group for <strong>@expiredCourses[0].Code &ndash; @expiredCourses[0].Title</strong> has passed its joining deadline. Contact your Class Representative.</text>
                        }
                        else
                        {
                            <text>@expiredCourses.Count courses have passed their WhatsApp group joining deadline:
                            @string.Join(", ", expiredCourses.Select(c => c.Code)).
                            Contact your Class Representative.</text>
                        }
                    </div>
                </div>
            }

            <div style="background:linear-gradient(135deg,#0D1E47 0%,#1C3B83 60%,#2952C8 100%);
                        border-radius:16px;padding:36px 32px 28px;margin-bottom:24px;position:relative;overflow:hidden;">

                <div style="position:absolute;top:-40px;right:-40px;width:200px;height:200px;
                            border-radius:50%;background:rgba(255,255,255,0.04);"></div>
                <div style="position:absolute;bottom:-60px;right:80px;width:280px;height:280px;
                            border-radius:50%;background:rgba(255,255,255,0.03);"></div>

                <div style="position:relative;z-index:1;">
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px;">
                        <i class="bi bi-search" style="color:#60a5fa;font-size:18px;"></i>
                        <span style="color:#93c5fd;font-size:12px;font-weight:700;
                                     text-transform:uppercase;letter-spacing:0.1em;">Course Explorer</span>
                    </div>
                    <h2 style="color:white;font-size:22px;font-weight:800;margin-bottom:4px;">
                        Find any course, lecturer or venue
                    </h2>
                    <p style="color:rgba(255,255,255,0.55);font-size:13px;margin-bottom:22px;">
                        Search across all @Model.Courses.Count enrolled course@(Model.Courses.Count != 1 ? "s" : "") &mdash; type a course code, name, lecturer or room
                    </p>

                    <div style="position:relative;max-width:700px;">
                        <i class="bi bi-search"
                           style="position:absolute;left:18px;top:50%;transform:translateY(-50%);
                                  color:#6b7280;font-size:16px;pointer-events:none;"></i>
                        <input type="text"
                               id="courseSearchInput"
                               placeholder="e.g. CSE301 &middot; Software Engineering &middot; Dr. Mugisha &middot; Room 204 ..."
                               oninput="filterCourses(this.value)"
                               onkeydown="if(event.key==='Enter'){event.preventDefault();filterCourses(this.value);}"
                               autocomplete="off"
                               style="width:100%;padding:16px 50px 16px 48px;border:none;
                                      border-radius:12px;font-size:14px;outline:none;
                                      background:rgba(255,255,255,0.97);color:#0D1E47;
                                      box-shadow:0 8px 30px rgba(0,0,0,0.25);" />
                        <button type="button" onclick="document.getElementById('courseSearchInput').value='';filterCourses('');"
                                id="clearSearch"
                                style="display:none;position:absolute;right:14px;top:50%;transform:translateY(-50%);
                                       background:none;border:none;cursor:pointer;color:#9ca3af;font-size:18px;">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    </div>

                    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:14px;">
                        @foreach (var dept in Model.Courses.Select(c => c.Code.Substring(0, Math.Min(3, c.Code.Length))).Distinct().Take(3))
                        {
                            <button type="button" onclick="filterCourses('@dept')"
                                    style="padding:6px 14px;border-radius:20px;border:1px solid rgba(255,255,255,0.2);
                                           background:rgba(255,255,255,0.1);color:white;font-size:11px;
                                           font-weight:600;cursor:pointer;transition:0.15s ease;"
                                    onmouseover="this.style.background='rgba(255,255,255,0.2)'"
                                    onmouseout="this.style.background='rgba(255,255,255,0.1)'">
                                @dept Courses
                            </button>
                        }
                        @foreach (var lec in Model.Courses.Select(c => c.Lecturer.Split(' ').LastOrDefault() ?? "").Where(l => l.Length > 2).Distinct().Take(2))
                        {
                            <button type="button" onclick="filterCourses('@lec')"
                                    style="padding:6px 14px;border-radius:20px;border:1px solid rgba(255,255,255,0.2);
                                           background:rgba(255,255,255,0.1);color:white;font-size:11px;
                                           font-weight:600;cursor:pointer;transition:0.15s ease;"
                                    onmouseover="this.style.background='rgba(255,255,255,0.2)'"
                                    onmouseout="this.style.background='rgba(255,255,255,0.1)'">
                                @lec
                            </button>
                        }
                        <button type="button" onclick="filterCourses('')"
                                style="padding:6px 14px;border-radius:20px;border:1px solid rgba(255,255,255,0.2);
                                       background:rgba(255,255,255,0.1);color:white;font-size:11px;
                                       font-weight:600;cursor:pointer;transition:0.15s ease;"
                                onmouseover="this.style.background='rgba(255,255,255,0.2)'"
                                onmouseout="this.style.background='rgba(255,255,255,0.1)'">
                            Show All
                        </button>
                    </div>
                </div>
            </div>

            <div id="searchResultsSection" style="display:none;margin-bottom:24px;">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
                    <span id="searchResultCount" style="font-size:13px;font-weight:600;color:#374151;"></span>
                    <button onclick="clearSearch()"
                            type="button"
                            style="font-size:12px;color:#1C3B83;background:none;border:none;cursor:pointer;font-weight:600;">
                        &#10005; Clear search
                    </button>
                </div>
                <div id="searchResultsGrid"
                     style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px;">
                </div>
            </div>

            <div id="dashboardContent" style="display:none;">
            <div id="courseData" style="display:none;">
                @foreach (var c in Model.Courses)
                {
                    <div class="course-item"
                         data-code="@c.Code"
                         data-title="@c.Title"
                         data-lecturer="@c.Lecturer"
                         data-time="@c.ScheduleTime"
                         data-venue="@c.Venue"
                         data-deadline="@c.JoinDeadline.ToString("dd MMM yyyy")"
                         data-delivered="@c.DeliveredHours"
                         data-scheduled="@c.ScheduledHours"
                         data-open="@(c.JoinDeadline >= DateTime.Now ? "true" : "false")"
                         data-url="@c.WhatsappGroupUrl">
                    </div>
                }
            </div>

            <div class="dash-stats dash-stats-4">

                <div class="dash-stat-card">
                    <div class="dash-stat-icon icon-blue">
                        <i class="bi bi-calendar3"></i>
                    </div>
                    <div class="dash-stat-body">
                        <strong>@Model.Courses.Count</strong>
                        <span>Enrolled Course@(Model.Courses.Count != 1 ? "s" : "")</span>
                    </div>
                </div>

                <div class="dash-stat-card">
                    <div class="dash-stat-icon icon-green">
                        <i class="bi bi-bar-chart-line-fill"></i>
                    </div>
                    <div class="dash-stat-body">
                        <strong>@(Model.Marks.Count > 0 ? $"{Model.AverageMark}%" : "N/A")</strong>
                        <span>Average Mark</span>
                    </div>
                </div>

                <div class="dash-stat-card">
                    <div class="dash-stat-icon icon-amber">
                        <i class="bi bi-chat-left-text-fill"></i>
                    </div>
                    <div class="dash-stat-body">
                        <strong>@Model.ActiveClaimCount</strong>
                        <span>Active Claim@(Model.ActiveClaimCount != 1 ? "s" : "")</span>
                    </div>
                </div>

                <div class="dash-stat-card">
                    <div class="dash-stat-icon icon-purple">
                        <i class="bi bi-bar-chart-fill"></i>
                    </div>
                    <div class="dash-stat-body">
                        @{
                            var totalDelivered  = Model.Courses.Sum(c => c.DeliveredHours);
                            var totalScheduled  = Model.Courses.Sum(c => c.ScheduledHours);
                            var attendanceRate  = totalScheduled > 0 ? Math.Round((double)totalDelivered / totalScheduled * 100, 1) : 0;
                        }
                        <strong>@(totalScheduled > 0 ? $"{attendanceRate}%" : "N/A")</strong>
                        <span>Delivery Rate</span>
                    </div>
                </div>

            </div>

            <div class="dash-grid-2-1">

                <div class="dash-card">
                    <div class="dash-card-header">
                        <div>
                            <h5>Weekly Class Schedule</h5>
                            <p>Your registered courses for this semester</p>
                        </div>
                        <a href="/Student/Schedule" class="btn-dash-outline btn-dash-sm">
                            <i class="bi bi-calendar3-week"></i> Full Schedule
                        </a>
                    </div>
                    <div class="dash-card-body" style="padding:0;">
                        @if (Model.Courses.Count == 0)
                        {
                            <div class="dash-empty">
                                <i class="bi bi-calendar3"></i>
                                <p>No courses enrolled yet.</p>
                            </div>
                        }
                        else
                        {
                            <table class="dash-table">
                                <thead>
                                    <tr>
                                        <th>Schedule</th>
                                        <th>Course</th>
                                        <th>Lecturer</th>
                                        <th>Venue</th>
                                        <th>Status</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in Model.Courses)
                                    {
                                        var pct    = c.ScheduledHours > 0 ? (double)c.DeliveredHours / c.ScheduledHours * 100 : 0;
                                        var isOpen = c.JoinDeadline >= DateTime.Now;
                                        string statusClass, statusIcon, statusLabel;
                                        if (pct >= 100) { statusClass = "badge-verified"; statusIcon = "check-circle-fill"; statusLabel = "Completed"; }
                                        else if (pct >= 60) { statusClass = "badge-verified"; statusIcon = "check-circle-fill"; statusLabel = "On Track"; }
                                        else if (pct >= 30) { statusClass = "badge-pending"; statusIcon = "clock-history"; statusLabel = "In Progress"; }
                                        else { statusClass = "badge-missed"; statusIcon = "x-circle-fill"; statusLabel = "Behind"; }

                                        var timeParts = c.ScheduleTime.Split(' ');
                                        var day  = timeParts.Length > 0 ? timeParts[0] : c.ScheduleTime;
                                        var time = timeParts.Length > 1 ? string.Join(" ", timeParts.Skip(1)) : "";

                                        <tr>
                                            <td>
                                                <strong>@day</strong>
                                                @if (!string.IsNullOrEmpty(time))
                                                {
                                                    <div style="font-size:11px;color:#9ca3af;">@time</div>
                                                }
                                            </td>
                                            <td>
                                                <strong style="display:block;font-size:13px;">@c.Code</strong>
                                                <span style="font-size:11px;color:#9ca3af;">@c.Title</span>
                                            </td>
                                            <td>@c.Lecturer</td>
                                            <td>@c.Venue</td>
                                            <td>
                                                <span class="badge-status @statusClass">
                                                    <i class="bi bi-@statusIcon"></i> @statusLabel
                                                </span>
                                            </td>
                                            <td>
                                                <a href="/Student/Schedule" class="btn-dash-icon" title="View schedule">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>

                <div class="dash-card">
                    <div class="dash-card-header">
                        <div>
                            <h5>Class WhatsApp Groups</h5>
                            <p>Official verified channels</p>
                        </div>
                    </div>
                    <div class="dash-card-body">
                        @if (Model.Courses.Count == 0)
                        {
                            <div class="dash-empty">
                                <i class="bi bi-whatsapp"></i>
                                <p>No groups available yet.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var c in Model.Courses)
                            {
                                var isOpen   = c.JoinDeadline >= DateTime.Now;
                                var hasGroup = !string.IsNullOrEmpty(c.WhatsappGroupUrl);
                                var daysLeft = (c.JoinDeadline - DateTime.Now).Days;
                                <div class="dash-group-card">
                                    <div class="dash-group-icon">
                                        <i class="bi bi-whatsapp"></i>
                                    </div>
                                    <div class="dash-group-info">
                                        <strong>@c.Code &ndash; @c.Title</strong>
                                        @if (!hasGroup)
                                        {
                                            <span style="color:#d97706;">No group link set yet</span>
                                        }
                                        else if (isOpen)
                                        {
                                            <span>Deadline: @daysLeft day@(daysLeft != 1 ? "s" : "") left</span>
                                        }
                                        else
                                        {
                                            <span style="color:#dc2626;">Deadline passed</span>
                                        }
                                    </div>
                                    <div class="dash-group-actions">
                                        @if (hasGroup && isOpen)
                                        {
                                            <a href="@c.WhatsappGroupUrl" target="_blank" class="btn-dash-primary btn-dash-sm">
                                                <i class="bi bi-whatsapp"></i> Join
                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn-dash-outline btn-dash-sm" disabled>
                                                @(hasGroup ? "Closed" : "Not Set")
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="dash-card">
                    <div class="dash-card-header">
                        <div>
                            <h5>Delivery Progress</h5>
                            <p>Hours delivered vs scheduled this semester</p>
                        </div>
                    </div>
                    <div class="dash-card-body">
                        @if (Model.Courses.Count == 0)
                        {
                            <div class="dash-empty">
                                <i class="bi bi-bar-chart"></i>
                                <p>No courses to show.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var c in Model.Courses)
                            {
                                var pct      = c.ScheduledHours > 0 ? (int)Math.Round((double)c.DeliveredHours / c.ScheduledHours * 100) : 0;
                                var barColor = pct >= 80 ? "#059669" : pct >= 50 ? "#d97706" : "#dc2626";
                                <div class="dash-progress-row">
                                    <span class="dash-progress-label">@c.Code &ndash; @c.Title.Split(' ').Take(2).Aggregate((a, b) => a + " " + b)</span>
                                    <div class="dash-progress-bar-wrap">
                                        <div class="dash-progress-bar-fill" style="width:@(pct)%;background:@barColor;"></div>
                                    </div>
                                    <span class="dash-progress-pct">@pct%</span>
                                </div>
                            }
                        }
                    </div>
                </div>

            </div>

            <div class="dash-card" id="section-marks">
                <div class="dash-card-header">
                    <div>
                        <h5>My Marks</h5>
                        <p>Assessment results posted by your lecturers this semester</p>
                    </div>
                    <a href="#section-marks" class="btn-dash-outline btn-dash-sm">
                        <i class="bi bi-file-earmark-text"></i> View All Marks
                    </a>
                </div>
                <div class="dash-card-body" style="padding:0;">
                    @if (Model.Marks.Count == 0)
                    {
                        <div class="dash-empty">
                            <i class="bi bi-bar-chart-line"></i>
                            <p>No published marks yet. Check back after assessments are graded.</p>
                        </div>
                    }
                    else
                    {
                        <table class="dash-table">
                            <thead>
                                <tr>
                                    <th>Course</th>
                                    <th>Lecturer</th>
                                    <th>Assessment</th>
                                    <th>Max</th>
                                    <th>Score</th>
                                    <th>Grade</th>
                                    <th>Status</th>
                                    <th>Claim</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model.Marks)
                                {
                                    var scoreColor = m.Percentage >= 70 ? "#059669" : m.Percentage >= 50 ? "#d97706" : "#dc2626";
                                    var gradeClass = m.Percentage >= 70 ? "badge-approved" : m.Percentage >= 50 ? "badge-pending" : "badge-missed";
                                    var alreadyClaimed = Model.Claims.Any(cl =>
                                        cl.CourseCode == m.CourseCode &&
                                        cl.AssessmentLabel == m.AssessmentLabel &&
                                        cl.Status == ClaimStatus.UnderReview);
                                    <tr>
                                        <td>
                                            <strong style="display:block;font-size:13px;">@m.CourseCode</strong>
                                            <span style="font-size:11px;color:#9ca3af;">@m.CourseTitle</span>
                                        </td>
                                        <td style="font-size:12px;">@m.LecturerName</td>
                                        <td style="font-size:12px;">@m.AssessmentLabel</td>
                                        <td style="font-size:13px;">@m.MaxScore</td>
                                        <td>
                                            <strong style="font-size:14px;color:@scoreColor;">@m.Score</strong>
                                        </td>
                                        <td><span class="badge-status @gradeClass">@m.Grade</span></td>
                                        <td>
                                            <span class="badge-status badge-verified">
                                                <i class="bi bi-patch-check-fill"></i> Published
                                            </span>
                                        </td>
                                        <td>
                                            @if (alreadyClaimed)
                                            {
                                                <button class="btn-dash-icon" disabled title="Claim already open">
                                                    <i class="bi bi-chat-left-text" style="color:#d1d5db;"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn-dash-icon" title="Raise a claim"
                                                        onclick="openClaimModal('@m.CourseCode','@m.AssessmentLabel','@m.LecturerName')">
                                                    <i class="bi bi-chat-left-text" style="color:#d97706;"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            <div class="dash-card" id="section-claims">
                <div class="dash-card-header">
                    <div>
                        <h5>My Mark Claims</h5>
                        <p>Disputes or queries you have raised about posted marks</p>
                    </div>
                    <button class="btn-dash-primary btn-dash-sm" onclick="openClaimModal('','','')">
                        <i class="bi bi-plus"></i> New Claim
                    </button>
                </div>
                <div class="dash-card-body" style="padding:0;">
                    @if (Model.Claims.Count == 0)
                    {
                        <div class="dash-empty">
                            <i class="bi bi-chat-left-text"></i>
                            <p>No claims raised yet. Click "New Claim" if you have a query about a posted mark.</p>
                        </div>
                    }
                    else
                    {
                        <table class="dash-table">
                            <thead>
                                <tr>
                                    <th>Date Raised</th>
                                    <th>Course</th>
                                    <th>Assessment</th>
                                    <th>Lecturer</th>
                                    <th>Your Reason</th>
                                    <th>Status</th>
                                    <th>Response</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var claim in Model.Claims)
                                {
                                    string claimClass, claimIcon, claimLabel;
                                    switch (claim.Status)
                                    {
                                        case ClaimStatus.Upheld:
                                            claimClass = "badge-verified"; claimIcon = "check-circle-fill"; claimLabel = "Upheld"; break;
                                        case ClaimStatus.PartiallyUpheld:
                                            claimClass = "badge-approved"; claimIcon = "check-circle"; claimLabel = "Partially Upheld"; break;
                                        case ClaimStatus.Rejected:
                                            claimClass = "badge-missed"; claimIcon = "x-circle-fill"; claimLabel = "Rejected"; break;
                                        default:
                                            claimClass = "badge-pending"; claimIcon = "clock-history"; claimLabel = "Under Review"; break;
                                    }
                                    <tr>
                                        <td style="font-size:12px;">@claim.RaisedOn.ToString("dd MMM yyyy")</td>
                                        <td>
                                            <strong style="display:block;font-size:13px;">@claim.CourseCode</strong>
                                            <span style="font-size:11px;color:#9ca3af;">@claim.CourseTitle</span>
                                        </td>
                                        <td style="font-size:12px;">@claim.AssessmentLabel</td>
                                        <td style="font-size:12px;">@claim.LecturerName</td>
                                        <td style="font-size:12px;max-width:180px;">@claim.Reason</td>
                                        <td>
                                            <span class="badge-status @claimClass">
                                                <i class="bi bi-@claimIcon"></i> @claimLabel
                                            </span>
                                        </td>
                                        <td style="font-size:12px;color:#9ca3af;">
                                            @(string.IsNullOrEmpty(claim.LecturerResponse) ? "Awaiting response..." : claim.LecturerResponse)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            </div><!-- /#dashboardContent -->

            <div id="claimModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.45);
                 z-index:3000;align-items:center;justify-content:center;">
                <div style="background:white;border-radius:14px;padding:28px;width:100%;max-width:500px;
                            margin:20px;box-shadow:0 20px 50px rgba(0,0,0,0.2);">

                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
                        <h5 style="margin:0;font-size:16px;color:#0D1E47;font-weight:700;">
                            <i class="bi bi-chat-left-text-fill" style="color:#d97706;margin-right:8px;"></i>
                            Raise a Mark Claim
                        </h5>
                        <button onclick="closeClaimModal()" style="background:none;border:none;font-size:18px;
                                color:#9ca3af;cursor:pointer;line-height:1;">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    <div class="dash-alert dash-alert-info" style="margin-bottom:18px;">
                        <i class="bi bi-info-circle-fill"></i>
                        <div style="font-size:12px;">
                            Your claim will be sent directly to the lecturer. They will review
                            and respond within 3 working days.
                        </div>
                    </div>

                    <form method="post" asp-page-handler="SubmitClaim">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="claim-course-h"     name="courseCode" />
                        <input type="hidden" id="claim-assessment-h" name="assessmentLabel" />
                        <input type="hidden" id="claim-lecturer-h"   name="lecturerName" />

                        <div style="margin-bottom:14px;">
                            <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:5px;">Course</label>
                            <input type="text" id="claim-course" readonly
                                   style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:7px;font-size:13px;outline:none;background:#f8fafc;" />
                        </div>

                        <div style="margin-bottom:14px;">
                            <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:5px;">Assessment</label>
                            <input type="text" id="claim-assessment" readonly
                                   style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:7px;font-size:13px;outline:none;background:#f8fafc;" />
                        </div>

                        <div style="margin-bottom:14px;">
                            <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:5px;">Lecturer</label>
                            <input type="text" id="claim-lecturer" readonly
                                   style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:7px;font-size:13px;outline:none;background:#f8fafc;" />
                        </div>

                        <div style="margin-bottom:20px;">
                            <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:5px;">
                                Reason for Claim <span style="color:#dc2626;">*</span>
                            </label>
                            <textarea name="reason" id="claim-reason" rows="4" required
                                      style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:7px;font-size:13px;outline:none;resize:vertical;"
                                      placeholder="Describe clearly why you believe the mark is incorrect..."></textarea>
                        </div>

                        <div style="display:flex;gap:10px;justify-content:flex-end;">
                            <button type="button" onclick="closeClaimModal()" class="btn-dash-outline">Cancel</button>
                            <button type="submit" class="btn-dash-primary">
                                <i class="bi bi-send-fill"></i> Submit Claim
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>

    </div>

</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>

    function revealAndScroll(sectionId) {
        var dash = document.getElementById('dashboardContent');
        if (dash) dash.style.display = 'block';
        var results = document.getElementById('searchResultsSection');
        if (results) results.style.display = 'none';
        setTimeout(function() {
            var el = document.getElementById(sectionId);
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 50);
    }

    function filterCourses(query) {
        var input = document.getElementById('courseSearchInput');
        if (input && query !== input.value) input.value = query;

        var clearBtn        = document.getElementById('clearSearch');
        var resultsSection  = document.getElementById('searchResultsSection');
        var resultsGrid     = document.getElementById('searchResultsGrid');
        var countEl         = document.getElementById('searchResultCount');
        var dashContent     = document.getElementById('dashboardContent');

        var q = (query || '').trim().toLowerCase();
        if (clearBtn) clearBtn.style.display = q ? 'block' : 'none';

        if (!q) {
            if (resultsSection) resultsSection.style.display = 'none';
            if (dashContent)    dashContent.style.display    = 'block';
            return;
        }

        if (dashContent) dashContent.style.display = 'none';

        var items   = document.querySelectorAll('#courseData .course-item');
        var matches = [];

        items.forEach(function(item) {
            var searchable = [
                item.dataset.code    || '',
                item.dataset.title   || '',
                item.dataset.lecturer|| '',
                item.dataset.time    || '',
                item.dataset.venue   || ''
            ].join(' ').toLowerCase();

            if (searchable.includes(q)) matches.push(item.dataset);
        });

        if (resultsSection) resultsSection.style.display = 'block';
        if (countEl) countEl.textContent =
            matches.length === 0
                ? 'No courses found for "' + query + '"'
                : matches.length + ' course' + (matches.length !== 1 ? 's' : '') + ' found for "' + query + '"';

        if (!resultsGrid) return;
        resultsGrid.innerHTML = '';

        if (matches.length === 0) {
            resultsGrid.innerHTML =
                '<div style="grid-column:1/-1;text-align:center;padding:40px;color:#9ca3af;">' +
                '<i class="bi bi-search" style="font-size:32px;display:block;margin-bottom:10px;color:#d1d5db;"></i>' +
                '<p style="font-size:13px;">No courses match your search. Try a different keyword.</p></div>';
            return;
        }

        matches.forEach(function(d) {
            var scheduled = parseInt(d.scheduled) || 0;
            var delivered = parseInt(d.delivered) || 0;
            var pct      = scheduled > 0 ? Math.round(delivered / scheduled * 100) : 0;
            var barColor = pct >= 80 ? '#059669' : pct >= 60 ? '#d97706' : '#dc2626';
            var isOpen   = d.open === 'true';

            var card = document.createElement('div');
            card.style.cssText =
                'background:white;border:1px solid #e5e7eb;border-radius:14px;padding:20px;transition:0.2s ease;cursor:default;';
            card.onmouseover = function() {
                this.style.boxShadow  = '0 8px 25px rgba(30,58,138,0.1)';
                this.style.borderColor = '#bfdbfe';
                this.style.transform   = 'translateY(-2px)';
            };
            card.onmouseout = function() {
                this.style.boxShadow  = '';
                this.style.borderColor = '#e5e7eb';
                this.style.transform   = '';
            };

            card.innerHTML =
                '<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;">' +
                    '<div>' +
                        '<span style="display:inline-block;background:#eff6ff;color:#1C3B83;font-size:11px;font-weight:700;padding:3px 9px;border-radius:6px;margin-bottom:6px;">' +
                            escHtml(d.code) +
                        '</span>' +
                        '<div style="font-size:14px;font-weight:700;color:#0D1E47;">' + escHtml(d.title) + '</div>' +
                    '</div>' +
                    (isOpen
                        ? '<span style="background:#ecfdf5;color:#059669;font-size:10px;font-weight:700;padding:3px 9px;border-radius:20px;white-space:nowrap;">\u25cf Open</span>'
                        : '<span style="background:#fef2f2;color:#dc2626;font-size:10px;font-weight:700;padding:3px 9px;border-radius:20px;white-space:nowrap;">Closed</span>') +
                '</div>' +
                '<div style="font-size:12px;color:#6b7280;margin-bottom:6px;">' +
                    '<i class="bi bi-person-fill" style="margin-right:5px;color:#1C3B83;"></i>' + escHtml(d.lecturer) +
                '</div>' +
                '<div style="font-size:12px;color:#6b7280;margin-bottom:6px;">' +
                    '<i class="bi bi-clock-fill" style="margin-right:5px;color:#1C3B83;"></i>' + escHtml(d.time) +
                '</div>' +
                '<div style="font-size:12px;color:#6b7280;margin-bottom:14px;">' +
                    '<i class="bi bi-geo-alt-fill" style="margin-right:5px;color:#1C3B83;"></i>' + escHtml(d.venue) +
                '</div>' +
                '<div style="margin-bottom:12px;">' +
                    '<div style="display:flex;justify-content:space-between;font-size:11px;color:#6b7280;margin-bottom:4px;">' +
                        '<span>Delivery progress</span>' +
                        '<span style="font-weight:700;color:' + barColor + ';">' + pct + '%</span>' +
                    '</div>' +
                    '<div style="height:5px;background:#f1f5f9;border-radius:5px;overflow:hidden;">' +
                        '<div style="height:100%;width:' + pct + '%;background:' + barColor + ';border-radius:5px;transition:width 0.4s;"></div>' +
                    '</div>' +
                '</div>' +
                (isOpen && d.url
                    ? '<a href="' + escHtml(d.url) + '" target="_blank" ' +
                       'style="display:flex;align-items:center;justify-content:center;gap:7px;padding:9px;background:#1C3B83;color:white;border-radius:8px;text-decoration:none;font-size:12px;font-weight:600;">' +
                       '<i class="bi bi-whatsapp"></i> Join WhatsApp Group</a>'
                    : '<div style="display:flex;align-items:center;justify-content:center;padding:9px;background:#f3f4f6;color:#9ca3af;border-radius:8px;font-size:12px;font-weight:600;">' +
                       (isOpen ? 'No group link set' : 'Group closed &middot; Deadline: ' + escHtml(d.deadline)) +
                       '</div>');

            resultsGrid.appendChild(card);
        });
    }

    function clearSearch() {
        var input = document.getElementById('courseSearchInput');
        if (input) input.value = '';
        filterCourses('');
        var dashContent = document.getElementById('dashboardContent');
        if (dashContent) dashContent.style.display = 'block';
    }

    function escHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function openClaimModal(course, assessment, lecturer) {
        document.getElementById('claim-course').value        = course     || '';
        document.getElementById('claim-assessment').value   = assessment || '';
        document.getElementById('claim-lecturer').value     = lecturer   || '';
        document.getElementById('claim-course-h').value     = course     || '';
        document.getElementById('claim-assessment-h').value = assessment || '';
        document.getElementById('claim-lecturer-h').value   = lecturer   || '';
        document.getElementById('claim-reason').value       = '';
        document.getElementById('claimModal').style.display = 'flex';
    }

    function closeClaimModal() {
        document.getElementById('claimModal').style.display = 'none';
    }

    document.getElementById('claimModal').addEventListener('click', function(e) {
        if (e.target === this) closeClaimModal();
    });

</script>
</body>
</html>
