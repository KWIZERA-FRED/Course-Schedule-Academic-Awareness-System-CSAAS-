@page
@model CourseScheduleSystem.Web.Pages.Student.NotificationsModel
@{
    ViewData["Title"] = "Notifications";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Notifications | CSAS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <style>
        .notif-item {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            padding: 18px 20px;
            border-bottom: 1px solid #f1f5f9;
            transition: background .15s ease;
            position: relative;
        }
        .notif-item:last-child { border-bottom: none; }
        .notif-item.unread { background: #f8fbff; }
        .notif-item:hover  { background: #f0f6ff; }

        .notif-dot {
            position: absolute;
            top: 22px; left: 8px;
            width: 7px; height: 7px;
            border-radius: 50%;
            background: #1C3B83;
        }

        .notif-icon {
            width: 42px; height: 42px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px; flex-shrink: 0;
        }
        .type-Info          { background:#eff6ff; color:#1C3B83; }
        .type-Warning       { background:#fef3c7; color:#d97706; }
        .type-Success       { background:#ecfdf5; color:#059669; }
        .type-Deadline      { background:#fef3c7; color:#d97706; }
        .type-MarkPosted    { background:#f5f3ff; color:#7c3aed; }
        .type-ClaimUpdate   { background:#fffbeb; color:#d97706; }
        .type-SessionUpdate { background:#ecfdf5; color:#059669; }

        .notif-body { flex: 1; }
        .notif-body strong { display: block; font-size: 13px; font-weight: 700; color: #0D1E47; margin-bottom: 3px; }
        .notif-body p      { font-size: 12px; color: #6b7280; line-height: 1.55; margin: 0; }
        .notif-time        { font-size: 10px; color: #9ca3af; margin-top: 5px; display: block; }

        .notif-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    </style>
</head>
<body>
<div class="dash-shell">

    
    <aside class="dash-sidebar">
        <a href="/" class="dash-sidebar-brand">
            <div class="dash-sidebar-brand-icon" style="background:transparent;box-shadow:none;padding:2px;">
                <img src="/images/logo.jpeg" alt="UNILAK" style="width:34px;height:34px;border-radius:50%;object-fit:cover;" />
            </div>
            <div class="dash-sidebar-brand-text">
                <strong>CSAS</strong>
                <span>Student Portal</span>
            </div>
        </a>

        <div class="dash-sidebar-section">Main Menu</div>
        <nav class="dash-sidebar-nav">
            <a href="/" class="dash-nav-link"><i class="bi bi-house-fill"></i> Home</a>
            <a href="/Student/Dashboard" class="dash-nav-link"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a href="/Student/Courses" class="dash-nav-link"><i class="bi bi-journal-bookmark-fill"></i> My Courses</a>
            <a href="/Student/Schedule" class="dash-nav-link"><i class="bi bi-calendar3-week"></i> My Schedule</a>
            <a href="/Student/Groups" class="dash-nav-link"><i class="bi bi-whatsapp"></i> Class Groups</a>
            <a href="/Student/Notifications" class="dash-nav-link active">
                <i class="bi bi-bell-fill"></i> Notifications
                @if (Model.UnreadCount > 0)
                {
                    <span style="margin-left:auto;background:#dc2626;color:white;
                                 font-size:10px;font-weight:700;padding:1px 7px;
                                 border-radius:20px;">@Model.UnreadCount</span>
                }
            </a>
        </nav>

                    <a href="https://umurongosmart.com/" target="_blank" class="dash-nav-link"
               title="UmurongoSmart Support"
               style="border-top:1px solid rgba(255,255,255,0.07);margin-top:4px;padding-top:12px;">
                <iconify-icon icon="mdi:headset-mic" style="font-size:16px;vertical-align:middle;"></iconify-icon> UmurongoSmart Support
            </a><div class="dash-sidebar-section">Account</div>
        <nav class="dash-sidebar-nav">
            <a href="/Profile" class="dash-nav-link"><i class="bi bi-person"></i> My Profile</a>
            <a href="/Logout" class="dash-nav-link"><i class="bi bi-box-arrow-left"></i> Logout</a>
        </nav>

        <div class="dash-sidebar-footer">
            <div class="dash-sidebar-user">
                <div class="dash-user-avatar"><i class="bi bi-person-fill"></i></div>
                <div class="dash-user-info">
                    <strong>@Model.CurrentUser.FullName</strong>
                    <span>Student</span>
                </div>
            </div>
        </div>
    </aside>

    
    <div class="dash-main">
        <div class="dash-topbar">
            <div class="dash-topbar-title">
                <h1>Notifications</h1>
                <p>
                    @if (Model.UnreadCount > 0)
                    {
                        <span>You have <strong>@Model.UnreadCount unread</strong> notification@(Model.UnreadCount != 1 ? "s" : "")</span>
                    }
                    else
                    {
                        <span>All caught up — no unread notifications</span>
                    }
                </p>
            </div>
            <div class="dash-topbar-actions">
                @if (Model.UnreadCount > 0)
                {
                    <form method="post" asp-page-handler="MarkAllRead" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-dash-outline btn-dash-sm">
                            <i class="bi bi-check2-all"></i> Mark All Read
                        </button>
                    </form>
                }
            </div>
        </div>

        <div class="dash-content">

            <div class="dash-card">
                <div class="dash-card-header">
                    <div>
                        <h5>All Notifications</h5>
                        <p>@Model.All.Count total · @Model.UnreadCount unread</p>
                    </div>
                </div>

                @if (!Model.All.Any())
                {
                    <div class="dash-empty">
                        <i class="bi bi-bell-slash"></i>
                        <p>No notifications yet. You'll see updates about marks, groups and sessions here.</p>
                    </div>
                }
                else
                {
                    <div style="padding:0;">
                        @foreach (var n in Model.All)
                        {
                            var iconClass = $"type-{n.Type}";
                            var icon = n.Type switch {
                                NotificationType.MarkPosted    => "bi-pencil-square",
                                NotificationType.ClaimUpdate   => "bi-chat-left-text-fill",
                                NotificationType.Deadline      => "bi-clock-fill",
                                NotificationType.Warning       => "bi-exclamation-triangle-fill",
                                NotificationType.Success       => "bi-check-circle-fill",
                                NotificationType.SessionUpdate => "bi-patch-check-fill",
                                _                              => "bi-info-circle-fill"
                            };
                            var timeAgo = (DateTime.Now - n.CreatedAt) switch {
                                var t when t.TotalMinutes < 60  => $"{(int)t.TotalMinutes}m ago",
                                var t when t.TotalHours  < 24  => $"{(int)t.TotalHours}h ago",
                                var t when t.TotalDays   < 7   => $"{(int)t.TotalDays}d ago",
                                _                              => n.CreatedAt.ToString("dd MMM yyyy")
                            };

                            <div class="notif-item @(!n.IsRead ? "unread" : "")">
                                @if (!n.IsRead)
                                {
                                    <div class="notif-dot"></div>
                                }
                                <div class="notif-icon @iconClass">
                                    <i class="bi @icon"></i>
                                </div>
                                <div class="notif-body">
                                    <strong>@n.Title</strong>
                                    <p>@n.Message</p>
                                    <span class="notif-time">
                                        <i class="bi bi-clock" style="margin-right:3px;"></i>@timeAgo
                                    </span>
                                </div>
                                <div class="notif-actions">
                                    @if (!string.IsNullOrEmpty(n.Link))
                                    {
                                        <a href="@n.Link" class="btn-dash-primary btn-dash-sm">
                                            View <i class="bi bi-arrow-right"></i>
                                        </a>
                                    }
                                    @if (!n.IsRead)
                                    {
                                        <form method="post" asp-page-handler="MarkRead" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@n.Id" />
                                            <button type="submit" class="btn-dash-icon" title="Mark as read">
                                                <i class="bi bi-check2"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>
    </div>
</div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
