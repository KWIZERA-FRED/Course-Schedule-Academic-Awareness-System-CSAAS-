@page
@model CourseScheduleSystem.Web.Pages.Student.GroupsModel
@{
    ViewData["Title"] = "Class Groups";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Class Groups | CSAS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <style>
        .group-big-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            padding: 24px;
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 14px;
            transition: .2s ease;
        }
        .group-big-card:hover { box-shadow: 0 6px 20px rgba(30,58,138,.08); transform: translateY(-2px); }
        .group-big-card.closed { opacity: .75; background: #fafafa; }
        .group-big-icon {
            width: 56px; height: 56px; border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 24px; flex-shrink: 0;
        }
        .group-big-body { flex: 1; }
        .group-big-body h4 { font-size: 15px; font-weight: 700; color: #0D1E47; margin-bottom: 4px; }
        .group-big-body .meta { font-size: 12px; color: #9ca3af; margin-bottom: 6px; }
        .group-big-body .url  { font-size: 11px; color: #1C3B83; word-break: break-all; }
        .deadline-badge {
            padding: 5px 12px; border-radius: 20px;
            font-size: 11px; font-weight: 700;
            white-space: nowrap;
        }
        .section-title {
            font-size: 11px; font-weight: 700; color: #9ca3af;
            text-transform: uppercase; letter-spacing: .08em;
            margin: 22px 0 12px;
            display: flex; align-items: center; gap: 8px;
        }
        .section-title::after {
            content: ''; flex: 1; height: 1px; background: #e5e7eb;
        }
    </style>
</head>
<body>
<div class="dash-shell">

    
    <aside class="dash-sidebar">
        <a href="/" class="dash-sidebar-brand">
            <div class="dash-sidebar-brand-icon" style="background:transparent;box-shadow:none;padding:2px;">
                <img src="/images/logo.jpeg" alt="UNILAK" style="width:34px;height:34px;border-radius:50%;object-fit:cover;" />
            </div>
            <div class="dash-sidebar-brand-text">
                <strong>CSAS</strong>
                <span>Student Portal</span>
            </div>
        </a>

        <div class="dash-sidebar-section">Main Menu</div>
        <nav class="dash-sidebar-nav">
            <a href="/" class="dash-nav-link"><i class="bi bi-house-fill"></i> Home</a>
            <a href="/Student/Dashboard" class="dash-nav-link"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a href="/Student/Courses" class="dash-nav-link"><i class="bi bi-journal-bookmark-fill"></i> My Courses</a>
            <a href="/Student/Schedule" class="dash-nav-link"><i class="bi bi-calendar3-week"></i> My Schedule</a>
            <a href="/Student/Groups" class="dash-nav-link active"><i class="bi bi-whatsapp"></i> Class Groups</a>
            <a href="/Student/Notifications" class="dash-nav-link"><i class="bi bi-bell"></i> Notifications</a>
        </nav>

                    <a href="https://umurongosmart.com/" target="_blank" class="dash-nav-link"
               title="UmurongoSmart Support"
               style="border-top:1px solid rgba(255,255,255,0.07);margin-top:4px;padding-top:12px;">
                <iconify-icon icon="mdi:headset-mic" style="font-size:16px;vertical-align:middle;"></iconify-icon> UmurongoSmart Support
            </a><div class="dash-sidebar-section">Account</div>
        <nav class="dash-sidebar-nav">
            <a href="/Profile" class="dash-nav-link"><i class="bi bi-person"></i> My Profile</a>
            <a href="/Logout" class="dash-nav-link"><i class="bi bi-box-arrow-left"></i> Logout</a>
        </nav>

        <div class="dash-sidebar-footer">
            <div class="dash-sidebar-user">
                <div class="dash-user-avatar"><i class="bi bi-person-fill"></i></div>
                <div class="dash-user-info">
                    <strong>@Model.CurrentUser.FullName</strong>
                    <span>Student</span>
                </div>
            </div>
        </div>
    </aside>

    
    <div class="dash-main">
        <div class="dash-topbar">
            <div class="dash-topbar-title">
                <h1>Class WhatsApp Groups</h1>
                <p>Official class communication groups — join before the deadline</p>
            </div>
            <div class="dash-topbar-actions">
                <a href="/Student/Notifications" class="dash-icon-btn" title="Notifications">
                    <i class="bi bi-bell"></i>
                </a>
            </div>
        </div>

        <div class="dash-content">

            
            <div class="dash-stats dash-stats-3" style="margin-bottom:24px;">
                <div class="dash-stat-card">
                    <div class="dash-stat-icon icon-green"><i class="bi bi-whatsapp"></i></div>
                    <div class="dash-stat-body">
                        <strong>@Model.OpenGroups.Count</strong>
                        <span>Open Groups</span>
                    </div>
                </div>
                <div class="dash-stat-card">
                    <div class="dash-stat-icon icon-amber"><i class="bi bi-door-closed"></i></div>
                    <div class="dash-stat-body">
                        <strong>@Model.ClosedGroups.Count</strong>
                        <span>Closed Groups</span>
                    </div>
                </div>
                <div class="dash-stat-card">
                    <div class="dash-stat-icon icon-blue"><i class="bi bi-hourglass-split"></i></div>
                    <div class="dash-stat-body">
                        <strong>@Model.NoGroup.Count</strong>
                        <span>Link Not Set Yet</span>
                    </div>
                </div>
            </div>

            
            @if (Model.OpenGroups.Any())
            {
                <div class="section-title">Open — Join Now</div>
                @foreach (var c in Model.OpenGroups)
                {
                    var days = (c.JoinDeadline - DateTime.Now).Days;
                    var deadlineColor = days <= 2 ? "#dc2626" : days <= 5 ? "#d97706" : "#059669";
                    <div class="group-big-card">
                        <div class="group-big-icon" style="background:#ecfdf5;color:#25d366;">
                            <i class="bi bi-whatsapp"></i>
                        </div>
                        <div class="group-big-body">
                            <h4>@c.Code — @c.Title</h4>
                            <div class="meta">
                                <i class="bi bi-person-fill" style="margin-right:4px;color:#1C3B83;"></i>@c.Lecturer
                                &nbsp;·&nbsp;
                                <i class="bi bi-clock" style="margin-right:4px;color:#1C3B83;"></i>@c.ScheduleTime
                            </div>
                            <div class="url">
                                <i class="bi bi-link-45deg" style="margin-right:4px;"></i>@c.WhatsappGroupUrl
                            </div>
                        </div>
                        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:10px;">
                            <span class="deadline-badge" style="background:#fef3c7;color:@deadlineColor;">
                                <i class="bi bi-clock-fill"></i>
                                @days day@(days != 1 ? "s" : "") left
                            </span>
                            <a href="@c.WhatsappGroupUrl" target="_blank"
                               class="btn-dash-primary btn-dash-sm">
                                <i class="bi bi-whatsapp"></i> Join Group
                            </a>
                        </div>
                    </div>
                }
            }

            
            @if (Model.ClosedGroups.Any())
            {
                <div class="section-title">Closed — Deadline Passed</div>
                @foreach (var c in Model.ClosedGroups)
                {
                    <div class="group-big-card closed">
                        <div class="group-big-icon" style="background:#f3f4f6;color:#9ca3af;">
                            <i class="bi bi-whatsapp"></i>
                        </div>
                        <div class="group-big-body">
                            <h4>@c.Code — @c.Title</h4>
                            <div class="meta">
                                <i class="bi bi-person-fill" style="margin-right:4px;color:#9ca3af;"></i>@c.Lecturer
                            </div>
                        </div>
                        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:10px;">
                            <span class="deadline-badge" style="background:#fef2f2;color:#dc2626;">
                                <i class="bi bi-x-circle-fill"></i> Closed
                            </span>
                            <span style="font-size:11px;color:#9ca3af;">
                                Contact your Class Rep
                            </span>
                        </div>
                    </div>
                }
            }

            
            @if (Model.NoGroup.Any())
            {
                <div class="section-title">Pending — Link Not Set Yet</div>
                @foreach (var c in Model.NoGroup)
                {
                    <div class="group-big-card">
                        <div class="group-big-icon" style="background:#fffbeb;color:#d97706;">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                        <div class="group-big-body">
                            <h4>@c.Code — @c.Title</h4>
                            <div class="meta">
                                <i class="bi bi-person-fill" style="margin-right:4px;color:#1C3B83;"></i>@c.Lecturer
                                &nbsp;·&nbsp;
                                <i class="bi bi-clock" style="margin-right:4px;color:#1C3B83;"></i>@c.ScheduleTime
                            </div>
                        </div>
                        <span class="deadline-badge" style="background:#fffbeb;color:#d97706;">
                            <i class="bi bi-exclamation-triangle-fill"></i> Awaiting CP
                        </span>
                    </div>
                }
            }

            
            @if (!Model.OpenGroups.Any() && !Model.ClosedGroups.Any() && !Model.NoGroup.Any())
            {
                <div class="dash-empty">
                    <i class="bi bi-whatsapp"></i>
                    <p>No courses found. You are not enrolled in any courses yet.</p>
                </div>
            }

        </div>
    </div>
</div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
